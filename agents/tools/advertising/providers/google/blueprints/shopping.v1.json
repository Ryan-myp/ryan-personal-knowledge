{
  "id": "google-ads.shopping",
  "version": "1.0.0",
  "provider": "google-ads",
  "ad_format": "SHOPPING",
  "title": "Google Shopping 广告",
  "description": "按 Google Shopping 类型配置 Merchant Center、商品广告组和商品分组。",
  "selector": {"dimension": "ad_format", "field": "campaign.advertising_channel_type", "values": ["SHOPPING"], "label": "Google 广告系列类型", "options": [{"value": "SHOPPING", "label": "购物"}]},
  "tools": ["google_create_campaign", "google_create_ad_group", "google_create_product_group"],
  "resources": ["campaign", "ad_group", "product_group"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "google_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.contains_eu_political_advertising", "tool_ref": "google_create_campaign.contains_eu_political_advertising", "label": "欧盟政治广告声明", "required": true, "source": "enum", "options": ["DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING", "CONTAINS_EU_POLITICAL_ADVERTISING"]},
    {"path": "campaign.advertising_channel_type", "tool_ref": "google_create_campaign.advertising_channel_type", "label": "广告系列类型（已根据入口匹配）", "required": true, "source": "enum", "options": ["SHOPPING"], "presentation": "derived_readonly"},
    {"path": "campaign.shopping_setting.merchant_id", "tool_ref": "google_create_campaign.shopping_setting.merchant_id", "label": "Merchant Center 账号", "required": true, "source": "tool_schema"},
    {"path": "campaign.shopping_setting.campaign_priority", "tool_ref": "google_create_campaign.shopping_setting.campaign_priority", "label": "Campaign 优先级（0-2）", "required": true, "source": "enum", "options": [0, 1, 2]},
    {"path": "campaign.shopping_setting.feed_label", "tool_ref": "google_create_campaign.shopping_setting.feed_label", "label": "商品 Feed 标签（可选）", "required": false, "source": "tool_schema"},
    {"path": "campaign.shopping_setting.enable_local", "tool_ref": "google_create_campaign.shopping_setting.enable_local", "label": "包含本地商品", "required": false, "source": "enum", "options": [true, false]},
    {"path": "campaign.bidding_strategy", "tool_ref": "google_create_campaign.bidding_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["MAXIMIZE_CONVERSION_VALUE", "TARGET_ROAS", "MANUAL_CPC"], "option_labels": {"MAXIMIZE_CONVERSION_VALUE": "最大化转化价值", "TARGET_ROAS": "目标 ROAS", "MANUAL_CPC": "人工 CPC"}},
    {"path": "campaign.target_roas", "tool_ref": "google_create_campaign.target_roas", "label": "目标 ROAS", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}},
    {"path": "campaign.daily_budget", "tool_ref": "google_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "ad_group.name", "tool_ref": "google_create_ad_group.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.type", "tool_ref": "google_create_ad_group.type", "label": "广告组类型（自动匹配）", "required": true, "source": "enum", "options": ["SHOPPING_PRODUCT_ADS"], "presentation": "derived_readonly"},
    {"path": "product_group.product_group_type", "tool_ref": "google_create_product_group.product_group_type", "label": "商品分组维度", "required": true, "source": "enum", "options": ["all_products", "product_type_1", "brand", "condition", "custom_label_0"]},
    {"path": "product_group.partition_type", "tool_ref": "google_create_product_group.partition_type", "label": "分组方式", "required": true, "source": "enum", "options": ["UNIT", "SUBDIVISION"]}
    ,{"path": "product_group.cpc_bid_micros", "tool_ref": "google_create_product_group.cpc_bid_micros", "label": "商品分组 CPC（微单位；UNIT 必填）", "required_when": {"field": "product_group.partition_type", "equals": "UNIT"}, "source": "tool_schema"},
    {"path": "product_group.status", "tool_ref": "google_create_product_group.status", "label": "商品分组状态", "required": false, "source": "enum", "options": ["PAUSED", "ENABLED"], "default": "PAUSED"}
  ],
  "rules": [{"id": "bidding_strategy_changed", "when": {"field": "campaign.bidding_strategy", "changed": true}, "reset": ["campaign.target_roas"]}]
}
