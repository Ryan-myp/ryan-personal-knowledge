{
  "id": "tiktok.traffic_video",
  "version": "3.0.0",
  "provider": "tiktok",
  "ad_format": "SINGLE_VIDEO",
  "title": "TikTok Traffic Spark Ads",
  "description": "使用 TikTok Upgraded Smart+ API 创建 Traffic Web Campaign；Traffic 映射为 WEB_CONVERSIONS + WEBSITE，并由广告组优化目标选择 CLICK 或 TRAFFIC_LANDING_PAGE_VIEW。",
  "match_terms": ["流量广告", "网站流量", "traffic campaign", "website traffic", "Spark traffic"],
  "selector": {
    "dimension": "objective",
    "field": "campaign.objective_type",
    "values": ["TRAFFIC"],
    "label": "TikTok 推广目标",
    "options": [{"value": "TRAFFIC", "label": "流量"}]
  },
  "tools": ["tiktok_smart_plus_create_campaign", "tiktok_smart_plus_create_adgroup", "tiktok_smart_plus_create_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "tiktok_smart_plus_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.objective_type", "tool_ref": "tiktok_smart_plus_create_campaign.objective_type", "label": "推广目标（已根据入口匹配）", "required": true, "source": "enum", "options": ["TRAFFIC"], "presentation": "derived_readonly"},
    {"path": "campaign.sales_destination", "tool_ref": "tiktok_smart_plus_create_campaign.sales_destination", "label": "推广目的地", "required": true, "source": "enum", "options": ["WEBSITE"], "presentation": "derived_readonly"},
    {"path": "ad_group.adgroup_name", "tool_ref": "tiktok_smart_plus_create_adgroup.adgroup_name", "label": "广告组名称", "required": true},
    {"path": "ad_group.location_ids", "tool_ref": "tiktok_smart_plus_create_adgroup.location_ids", "label": "投放地区", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_regions"},
    {"path": "ad_group.saved_audience_id", "tool_ref": "tiktok_smart_plus_create_adgroup.saved_audience_id", "label": "Saved Audience（可选）", "required": false},
    {"path": "ad_group.gender", "tool_ref": "tiktok_smart_plus_create_adgroup.gender", "label": "性别", "required": false, "source": "enum", "options": ["GENDER_UNLIMITED", "GENDER_MALE", "GENDER_FEMALE"]},
    {"path": "ad_group.age_groups", "tool_ref": "tiktok_smart_plus_create_adgroup.age_groups", "label": "年龄段", "required": false, "source": "enum", "options": ["AGE_13_17", "AGE_18_24", "AGE_25_34", "AGE_35_44", "AGE_45_54", "AGE_55_64", "AGE_65+"]},
    {"path": "ad_group.promotion_type", "tool_ref": "tiktok_smart_plus_create_adgroup.promotion_type", "label": "优化位置", "required": true, "source": "enum", "options": ["WEBSITE"]},
    {"path": "ad_group.budget_mode", "tool_ref": "tiktok_smart_plus_create_adgroup.budget_mode", "label": "预算模式", "required": true, "source": "enum", "options": ["BUDGET_MODE_DYNAMIC_DAILY_BUDGET", "BUDGET_MODE_TOTAL", "BUDGET_MODE_INFINITE"]},
    {"path": "ad_group.budget", "tool_ref": "tiktok_smart_plus_create_adgroup.budget", "label": "预算（填写时最低 20）", "required_when": {"field": "ad_group.budget_mode", "in": ["BUDGET_MODE_DYNAMIC_DAILY_BUDGET", "BUDGET_MODE_TOTAL"]}},
    {"path": "ad_group.schedule_type", "tool_ref": "tiktok_smart_plus_create_adgroup.schedule_type", "label": "投放时间设置", "required": true, "source": "enum", "options": ["SCHEDULE_FROM_NOW", "SCHEDULE_START_END"]},
    {"path": "ad_group.schedule_start_time", "tool_ref": "tiktok_smart_plus_create_adgroup.schedule_start_time", "label": "开始投放时间", "required": true},
    {"path": "ad_group.schedule_end_time", "tool_ref": "tiktok_smart_plus_create_adgroup.schedule_end_time", "label": "结束投放时间", "required_when": {"field": "ad_group.schedule_type", "equals": "SCHEDULE_START_END"}},
    {"path": "ad_group.optimization_goal", "tool_ref": "tiktok_smart_plus_create_adgroup.optimization_goal", "label": "优化目标", "required": true, "source": "enum", "options": ["CLICK", "TRAFFIC_LANDING_PAGE_VIEW"], "options_from": ["campaign.objective_type"]},
    {"path": "ad_group.bid_type", "tool_ref": "tiktok_smart_plus_create_adgroup.bid_type", "label": "出价方式", "required": true, "source": "enum", "options": ["BID_TYPE_NO_BID", "BID_TYPE_CUSTOM"]},
    {"path": "ad_group.bid_price", "tool_ref": "tiktok_smart_plus_create_adgroup.bid_price", "label": "点击成本上限", "required_when": {"field": "ad_group.bid_type", "equals": "BID_TYPE_CUSTOM"}},
    {"path": "ad_group.conversion_bid_price", "tool_ref": "tiktok_smart_plus_create_adgroup.conversion_bid_price", "label": "落地页浏览成本上限", "required_when": {"field": "ad_group.optimization_goal", "equals": "TRAFFIC_LANDING_PAGE_VIEW"}},
    {"path": "ad.ad_name", "tool_ref": "tiktok_smart_plus_create_ad.ad_name", "label": "广告名称", "required": true},
    {"path": "ad.identity_type", "tool_ref": "tiktok_smart_plus_create_ad.identity_type", "label": "广告身份类型", "required": true, "source": "enum", "options": ["AUTH_CODE", "TT_USER", "BC_AUTH_TT"]},
    {"path": "ad.identity_id", "tool_ref": "tiktok_smart_plus_create_ad.identity_id", "label": "广告身份", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_identities"},
    {"path": "ad.identity_authorized_bc_id", "tool_ref": "tiktok_smart_plus_create_ad.identity_authorized_bc_id", "label": "Business Center ID", "required_when": {"field": "ad.identity_type", "equals": "BC_AUTH_TT"}},
    {"path": "ad.tiktok_item_id", "tool_ref": "tiktok_smart_plus_create_ad.tiktok_item_id", "label": "已授权 TikTok 帖子", "required": true},
    {"path": "ad.call_to_action_id", "tool_ref": "tiktok_smart_plus_create_ad.call_to_action_id", "label": "行动号召", "required": true},
    {"path": "ad.landing_page_url", "tool_ref": "tiktok_smart_plus_create_ad.landing_page_url", "label": "落地页链接", "required": true}
  ],
  "rules": [
    {"id": "objective_changed", "when": {"field": "campaign.objective_type", "changed": true}, "reset": ["ad_group.optimization_goal", "ad_group.bid_price", "ad_group.conversion_bid_price"]}
  ]
}
