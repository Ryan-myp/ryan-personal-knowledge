{
  "id": "tiktok.app_conversion_video",
  "version": "3.0.3",
  "provider": "tiktok",
  "ad_format": "SINGLE_VIDEO",
  "title": "TikTok App 推广视频广告",
  "description": "按实际 Campaign 自动化类型使用标准 Campaign、Ad Group 和 App Ad API，所有新建层级保持暂停。",
  "match_terms": ["App 广告", "App 推广", "应用再营销", "应用转化", "app promotion", "app retargeting"],
  "selector": {
    "dimension": "objective",
    "field": "campaign.objective_type",
    "values": ["APP_PROMOTION"],
    "label": "TikTok 推广目标",
    "options": [{"value": "APP_PROMOTION", "label": "App 推广"}]
  },
  "tools": ["tiktok_create_campaign", "tiktok_create_adgroup", "tiktok_create_app_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "tiktok_create_campaign.name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.status", "tool_ref": "tiktok_create_campaign.status", "label": "Campaign 状态", "source": "enum", "options": [0], "default": 0, "presentation": "derived_readonly"},
    {"path": "campaign.objective_type", "tool_ref": "tiktok_create_campaign.objective_type", "label": "推广目标", "required": true, "source": "enum", "options": ["APP_PROMOTION"], "presentation": "derived_readonly"},
    {"path": "campaign.app_promotion_type", "tool_ref": "tiktok_create_campaign.app_promotion_type", "label": "App 推广方式", "required": true, "source": "enum", "options": ["APP_INSTALL", "APP_RETARGETING"]},
    {"path": "campaign.campaign_type", "tool_ref": "tiktok_create_campaign.campaign_type", "label": "Campaign 类型", "required": true, "source": "enum", "options": ["REGULAR_CAMPAIGN", "IOS14_CAMPAIGN"]},
    {"path": "campaign.campaign_automation_type", "tool_ref": "tiktok_create_campaign.campaign_automation_type", "label": "自动化类型", "source": "enum", "options": ["MANUAL"], "default": "MANUAL", "presentation": "derived_readonly"},
    {"path": "campaign.budget_mode", "tool_ref": "tiktok_create_campaign.budget_mode", "label": "Campaign 预算模式", "source": "enum", "options": ["BUDGET_MODE_INFINITE"], "default": "BUDGET_MODE_INFINITE", "presentation": "derived_readonly"},
    {"path": "ad_group.adgroup_name", "tool_ref": "tiktok_create_adgroup.name", "label": "广告组名称", "default_strategy": "generated_name"},
    {"path": "ad_group.status", "tool_ref": "tiktok_create_adgroup.status", "label": "广告组状态", "source": "enum", "options": [0], "default": 0, "presentation": "derived_readonly"},
    {"path": "ad_group.promotion_type", "tool_ref": "tiktok_create_adgroup.promotion_type", "label": "推广位置", "required": true, "source": "enum", "options": ["APP_ANDROID", "APP_IOS"]},
    {"path": "ad_group.app_id", "tool_ref": "tiktok_create_adgroup.app_id", "label": "推广 App", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_apps"},
    {"path": "ad_group.optimization_goal", "tool_ref": "tiktok_create_adgroup.optimization_goal", "label": "优化目标", "required": true, "source": "enum", "options": ["INSTALL", "IN_APP_EVENT", "VALUE"]},
    {"path": "ad_group.optimization_event", "tool_ref": "tiktok_create_adgroup.optimization_event", "label": "应用内事件", "required_when": {"field": "ad_group.optimization_goal", "in": ["IN_APP_EVENT", "VALUE"]}},
    {"path": "ad_group.billing_event", "tool_ref": "tiktok_create_adgroup.billing_event", "label": "计费事件", "required": true, "source": "enum", "options": ["OCPM"]},
    {"path": "ad_group.bid_type", "tool_ref": "tiktok_create_adgroup.bid_type", "label": "出价方式", "required": true, "source": "enum", "options": ["BID_TYPE_NO_BID"]},
    {"path": "ad_group.deep_bid_type", "tool_ref": "tiktok_create_adgroup.deep_bid_type", "label": "深度优化", "source": "enum", "options": ["AEO"]},
    {"path": "ad_group.location_ids", "tool_ref": "tiktok_create_adgroup.location_ids", "label": "投放地区", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_regions"},
    {"path": "ad_group.operating_systems", "tool_ref": "tiktok_create_adgroup.operating_systems", "label": "操作系统", "required": true, "source": "enum", "options": ["ANDROID", "IOS"], "options_from": ["ad_group.promotion_type"], "option_rules": [{"when": {"field": "ad_group.promotion_type", "equals": "APP_ANDROID"}, "options": ["ANDROID"]}, {"when": {"field": "ad_group.promotion_type", "equals": "APP_IOS"}, "options": ["IOS"]}]},
    {"path": "ad_group.budget_mode", "tool_ref": "tiktok_create_adgroup.budget_mode", "label": "预算模式", "required": true, "source": "enum", "options": ["BUDGET_MODE_DAY"], "default": "BUDGET_MODE_DAY", "presentation": "derived_readonly"},
    {"path": "ad_group.budget", "tool_ref": "tiktok_create_adgroup.budget", "label": "日预算（USD）", "required": true},
    {"path": "ad_group.daily_budget", "tool_ref": "tiktok_create_adgroup.daily_budget", "label": "日预算引用", "presentation": "derived_readonly"},
    {"path": "ad_group.schedule_type", "tool_ref": "tiktok_create_adgroup.schedule_type", "label": "排期模式", "required": true, "source": "enum", "options": ["SCHEDULE_START_END"], "default": "SCHEDULE_START_END", "presentation": "derived_readonly"},
    {"path": "ad_group.schedule_start_time", "tool_ref": "tiktok_create_adgroup.schedule_start_time", "label": "开始时间（UTC）", "required": true},
    {"path": "ad_group.schedule_end_time", "tool_ref": "tiktok_create_adgroup.schedule_end_time", "label": "结束时间（UTC）", "required": true},
    {"path": "ad.ad_name", "tool_ref": "tiktok_create_app_ad.name", "label": "广告名称", "default_strategy": "generated_name"},
    {"path": "ad.status", "tool_ref": "tiktok_create_app_ad.status", "label": "广告状态", "source": "enum", "options": [0], "default": 0, "presentation": "derived_readonly"},
    {"path": "ad.app_id", "tool_ref": "tiktok_create_app_ad.app_id", "label": "App 引用", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_apps"},
    {"path": "ad.app_name", "tool_ref": "tiktok_create_app_ad.app_name", "label": "App 展示名称", "required": true},
    {"path": "ad.promotion_type", "tool_ref": "tiktok_create_app_ad.promotion_type", "label": "App 平台", "required": true, "source": "enum", "options": ["APP_ANDROID", "APP_IOS"]},
    {"path": "ad.operating_systems", "tool_ref": "tiktok_create_app_ad.operating_systems", "label": "App 操作系统", "required": true, "source": "enum", "options": ["ANDROID", "IOS"]},
    {"path": "ad.ad_format", "tool_ref": "tiktok_create_app_ad.ad_format", "label": "素材形式", "source": "enum", "options": ["SINGLE_VIDEO"], "default": "SINGLE_VIDEO", "presentation": "derived_readonly"},
    {"path": "ad.video_id", "tool_ref": "tiktok_create_app_ad.video_id", "label": "视频素材", "required": true, "source": "lookup", "lookup_tool": "tiktok_get_video", "presentation": "asset_picker"},
    {"path": "ad.image_ids", "tool_ref": "tiktok_create_app_ad.image_ids", "label": "封面素材", "source": "lookup", "lookup_tool": "tiktok_list_images", "presentation": "asset_picker"},
    {"path": "ad.identity_type", "tool_ref": "tiktok_create_app_ad.identity_type", "label": "身份类型", "source": "enum", "options": ["AUTH_CODE", "TT_USER", "BC_AUTH_TT"]},
    {"path": "ad.identity_id", "tool_ref": "tiktok_create_app_ad.identity_id", "label": "广告身份", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_identities"},
    {"path": "ad.text", "tool_ref": "tiktok_create_app_ad.text", "label": "广告文案", "required": true},
    {"path": "ad.call_to_action", "tool_ref": "tiktok_create_app_ad.call_to_action", "label": "行动号召"},
    {"path": "ad.deep_link", "tool_ref": "tiktok_create_app_ad.deep_link", "label": "App 深链"},
    {"path": "ad.click_tracking_url", "tool_ref": "tiktok_create_app_ad.click_tracking_url", "label": "点击归因 URL", "manual_entry": {"title": "MMP 点击归因 URL", "instructions": "仅填写应用归因服务商提供的有效 URL；不要从其他广告或示例中猜填。", "source": "provider_tracking_url"}},
    {"path": "ad.impression_tracking_url", "tool_ref": "tiktok_create_app_ad.impression_tracking_url", "label": "展示归因 URL", "manual_entry": {"title": "MMP 展示归因 URL", "instructions": "仅填写应用归因服务商提供的有效 URL；不要从其他广告或示例中猜填。", "source": "provider_tracking_url"}}
  ],
  "rules": [
    {"id": "objective_changed", "when": {"field": "campaign.objective_type", "changed": true}, "reset": ["ad_group.app_id", "ad_group.promotion_type", "ad_group.optimization_goal", "ad_group.operating_systems", "ad.app_id", "ad.promotion_type", "ad.operating_systems"]},
    {"id": "app_changed", "when": {"field": "ad_group.app_id", "changed": true}, "reset": ["ad.app_id"]},
    {"id": "promotion_changed", "when": {"field": "ad_group.promotion_type", "changed": true}, "reset": ["ad_group.operating_systems", "ad.promotion_type", "ad.operating_systems"]}
  ]
}
