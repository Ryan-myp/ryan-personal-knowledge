{
  "id": "meta.awareness",
  "version": "1.0.0",
  "provider": "meta",
  "ad_format": "awareness",
  "title": "Meta 品牌认知广告",
  "description": "按 Awareness 目标创建 Campaign、Ad Set 和图片/视频链接广告；支持覆盖与展示优化。",
  "match_terms": [
    "品牌认知",
    "品牌曝光",
    "awareness",
    "reach"
  ],
  "selector": {
    "dimension": "objective",
    "field": "campaign.objective",
    "values": [
      "OUTCOME_AWARENESS"
    ],
    "label": "Meta 推广目标",
    "options": [
      {
        "value": "OUTCOME_AWARENESS",
        "label": "品牌认知"
      }
    ]
  },
  "tools": [
    "meta_create_campaign",
    "meta_create_adset",
    "meta_create_awareness_ad"
  ],
  "resources": [
    "campaign",
    "ad_set",
    "ad"
  ],
  "fields": [
    {
      "path": "campaign.name",
      "tool_ref": "meta_create_campaign.name",
      "label": "Campaign 名称",
      "required": true
    },
    {
      "path": "campaign.objective",
      "tool_ref": "meta_create_campaign.objective",
      "label": "推广目标（已根据入口匹配）",
      "required": true,
      "source": "enum",
      "options": [
        "OUTCOME_AWARENESS"
      ],
      "presentation": "derived_readonly"
    },
    {
      "path": "campaign.special_ad_categories",
      "tool_ref": "meta_create_campaign.special_ad_categories",
      "label": "特殊广告类别",
      "required": true,
      "source": "enum"
    },
    {
      "path": "campaign.buying_type",
      "tool_ref": "meta_create_campaign.buying_type",
      "label": "购买类型",
      "required": true,
      "source": "enum",
      "options": [
        "AUCTION"
      ]
    },
    {
      "path": "campaign.daily_budget",
      "tool_ref": "meta_create_campaign.daily_budget",
      "label": "日预算",
      "required": true
    },
    {
      "path": "ad_set.name",
      "tool_ref": "meta_create_adset.name",
      "label": "广告组名称",
      "required": true
    },
    {
      "path": "ad_set.optimization_goal",
      "tool_ref": "meta_create_adset.optimization_goal",
      "label": "优化目标",
      "required": true,
      "source": "enum",
      "options": [
        "REACH",
        "IMPRESSIONS"
      ]
    },
    {
      "path": "ad_set.billing_event",
      "tool_ref": "meta_create_adset.billing_event",
      "label": "计费事件",
      "required": true,
      "source": "enum",
      "options": [
        "IMPRESSIONS"
      ]
    },
    {
      "path": "ad_set.bid_strategy",
      "tool_ref": "meta_create_adset.bid_strategy",
      "label": "出价策略",
      "required": true,
      "source": "enum",
      "options": [
        "LOWEST_COST_WITHOUT_CAP",
        "LOWEST_COST_WITH_BID_CAP"
      ]
    },
    {
      "path": "ad_set.targeting",
      "tool_ref": "meta_create_adset.targeting",
      "label": "定向",
      "required": true
    },
    {
      "path": "ad_set.start_time",
      "tool_ref": "meta_create_adset.start_time",
      "label": "开始时间",
      "required": true
    },
    {
      "path": "ad_set.end_time",
      "tool_ref": "meta_create_adset.end_time",
      "label": "结束时间",
      "required": false
    },
    {
      "path": "ad.name",
      "tool_ref": "meta_create_awareness_ad.name",
      "label": "广告名称",
      "required": true
    },
    {
      "path": "ad.page_id",
      "tool_ref": "meta_create_awareness_ad.page_id",
      "label": "Facebook Page",
      "required": true,
      "source": "lookup",
      "lookup_tool": "meta_list_pages"
    },
    {
      "path": "ad.link",
      "tool_ref": "meta_create_awareness_ad.link",
      "label": "落地页链接",
      "required": true
    },
    {
      "path": "ad.media_type",
      "tool_ref": "meta_create_awareness_ad.media_type",
      "label": "素材类型",
      "required": true,
      "source": "enum",
      "options": [
        "IMAGE",
        "VIDEO"
      ],
      "option_labels": {
        "IMAGE": "图片",
        "VIDEO": "视频"
      }
    },
    {
      "path": "ad.message",
      "tool_ref": "meta_create_awareness_ad.message",
      "label": "主要文案",
      "required": false
    },
    {
      "path": "ad.headline",
      "tool_ref": "meta_create_awareness_ad.headline",
      "label": "标题",
      "required": false
    },
    {
      "path": "ad.description",
      "tool_ref": "meta_create_awareness_ad.description",
      "label": "描述",
      "required": false
    },
    {
      "path": "ad.call_to_action_type",
      "tool_ref": "meta_create_awareness_ad.call_to_action_type",
      "label": "行动号召",
      "required": false,
      "source": "enum",
      "options": [
        "LEARN_MORE",
        "SHOP_NOW",
        "SIGN_UP",
        "CONTACT_US"
      ],
      "option_labels": {
        "LEARN_MORE": "了解更多",
        "SHOP_NOW": "立即购买",
        "SIGN_UP": "注册",
        "CONTACT_US": "联系我们"
      }
    },
    {
      "path": "ad.image_hash",
      "tool_ref": "meta_create_awareness_ad.image_hash",
      "label": "图片素材 ID / 本地文件草稿",
      "presentation": "file_reference",
      "accept": "image/*",
      "visible_when": {
        "field": "ad.media_type",
        "equals": "IMAGE"
      },
      "required_when": {
        "field": "ad.media_type",
        "equals": "IMAGE"
      }
    },
    {
      "path": "ad.video_id",
      "tool_ref": "meta_create_awareness_ad.video_id",
      "label": "视频素材 ID / 本地文件草稿",
      "presentation": "file_reference",
      "accept": "video/*",
      "visible_when": {
        "field": "ad.media_type",
        "equals": "VIDEO"
      },
      "required_when": {
        "field": "ad.media_type",
        "equals": "VIDEO"
      }
    }
  ],
  "rules": [
    {
      "id": "objective_changed",
      "when": {
        "field": "campaign.objective",
        "changed": true
      },
      "reset": [
        "ad_set.optimization_goal",
        "ad_set.billing_event"
      ]
    },
    {
      "id": "media_type_changed",
      "when": {
        "field": "ad.media_type",
        "changed": true
      },
      "reset": [
        "ad.video_id"
      ]
    }
  ]
}
