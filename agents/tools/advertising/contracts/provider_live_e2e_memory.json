    {
      "id": "tiktok_smart_plus_ad_creative_identity",
      "applies_to": [{"provider": "tiktok", "campaign_type": "TRAFFIC"}],
      "status": "resolved",
      "root_cause": "TikTok's standard ad/get list can return a Smart+ row whose ad_id and operation_status describe the linked creative, while smart_plus_ad_id and smart_plus/ad/get identify the delivery Ad. The stale list row also kept the old creative label after the Ad name was updated.",
      "fix": "Use smart_plus_ad_id as canonical ad_id; preserve a different raw ad_id as smart_plus_creative_id and its status as creative_operation_status. When a standard list contains Smart+ rows, refresh from smart_plus/ad/get and prefer its current Ad name and delivery status.",
      "next_action": "Keep list/get ID, status, and updated-name regressions. Never interpret creative ENABLE as delivery Ad ENABLE; verify operation_status on the Smart+ Ad object.",
      "regression_tests": [
        "test_tiktok_smart_plus_ad_list_keeps_ad_and_creative_ids_distinct",
        "test_tiktok_smart_plus_list_prefers_current_ad_details_over_linked_creative_rows"
