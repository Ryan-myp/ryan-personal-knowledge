    {
      "id": "tiktok_smart_plus_recorder_schema",
      "applies_to": [{"provider": "tiktok", "campaign_type": "TRAFFIC"}],
      "status": "resolved",
      "root_cause": "The long-lived 8770 service had loaded an older E2E ProviderRecorder. It treated the Smart+ Ad create endpoint as the legacy creatives[] shape instead of validating top-level operation_status=DISABLE and the Smart+ creative_list payload.",
      "fix": "Special-case the Smart+ Ad endpoint in the recorder and restart the isolated E2E service after changing recorder code.",
      "next_action": "Keep the regression tests and restart rule; verify the provider-http evidence contains an Ad create request before marking the Ad live.",
      "regression_tests": [
        "test_tiktok_smart_plus_ad_create_accepts_disabled_ad_status",
        "test_tiktok_smart_plus_ad_create_rejects_enabled_or_missing_status"
      ]
    },
    {
      "id": "tiktok_lookup_provider_502",
      "applies_to": [{"provider": "tiktok", "campaign_type": "TRAFFIC"}],
      "status": "resolved",
      "root_cause": "The initial signed-selection attempt hit transient TikTok read/lookup failures before any Ad create request. The existing Campaign and Ad Group remained intact; after lookup recovered, a single child-only /chat call created the Ad.",
      "fix": "Retry only the failed read/selection lookup with bounded backoff, then resume the missing child Tool using fresh session-bound selection tokens. Never replay successful parent creates.",
      "next_action": "If a scoped lookup returns 502 again, preserve existing parents and retry only that read. Reconcile an ambiguous write by exact get/list before considering any retry.",
      "regression_tests": [
        "test_chat_keeps_selection_tokens_structured_and_redacts_prompt",
        "test_chat_keeps_blueprint_metadata_out_of_tool_arguments"
