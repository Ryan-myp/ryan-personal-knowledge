            ],
            "constraints": [],
            "depends_on": {}
          },
          "bid_amount": {
            "name": "bid_amount",
            "type": "integer",
            "required": false,
            "description": "出价金额（美分）",
            "valid_values": [],
            "constraints": [],
            "depends_on": {}
          },
          "targeting": {
