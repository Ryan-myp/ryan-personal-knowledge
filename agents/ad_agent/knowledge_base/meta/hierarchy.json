              "PRODUCT_CATALOG_SALES"
            ],
            "constraints": [
              {
                "condition": {
                  "campaign_objective": "APP_INSTALLS"
                },
                "effect": {
                  "allowed_goals": [
                    "APP_INSTALLS",
                    "APP_EVENTS"
                  ]
                },
                "description": "应用安装目标只能选择相关优化目标"
              }
            ],
            "depends_on": {}
          },
          "billing_event": {
            "name": "billing_event",
            "type": "string",
