            "required": false,
            "description": "定向设置",
            "valid_values": [],
            "constraints": [],
            "depends_on": {}
          },
          "start_time": {
            "name": "start_time",
            "type": "datetime",
            "required": false,
            "description": "开始时间",
            "valid_values": [],
            "constraints": [],
            "depends_on": {}
          },
          "end_time": {
            "name": "end_time",
            "type": "datetime",
            "required": false,
            "description": "结束时间",
            "valid_values": [],
            "constraints": [],
            "depends_on": {}
          }
        },
        "valid_combinations": [
          {
            "campaign_objective": "APP_INSTALLS",
            "optimization_goal": "APP_INSTALLS",
            "billing_event": "IMPRESSIONS"
          }
        ]
      },
