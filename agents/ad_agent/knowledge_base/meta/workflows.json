    {
      "entry_id": "meta_create_campaign_adset_ad",
      "knowledge_type": "WORKFLOW",
      "platform": "meta",
      "content": {
        "type": "create_campaign_adset_ad",
        "description": "Meta 完整创建流程（Campaign → AdSet → Ad）",
        "steps": [
          {
            "step": 1,
            "action": "create_campaign",
            "level": "campaign",
            "required_params": ["account_id", "name", "objective"],
            "optional_params": ["special_ad_categories", "daily_budget"],
            "api_endpoint": "https://graph.facebook.com/v18.0/{account-id}/campaigns",
            "method": "POST",
            "validation": "objective 必须是有效枚举值"
          },
          {
            "step": 2,
            "action": "create_adset",
            "level": "adset",
            "required_params": ["campaign_id", "name", "optimization_goal", "billing_event", "targeting"],
            "api_endpoint": "https://graph.facebook.com/v18.0/{account-id}/adsets",
            "method": "POST",
            "validation": "optimization_goal 必须与 Campaign objective 匹配",
            "notes": ["targeting 必须是 JSON 字符串", "daily_budget 单位为分"]
          },
          {
            "step": 3,
            "action": "create_ad",
            "level": "ad",
            "required_params": ["adgroup_id", "name", "status", "creative"],
            "api_endpoint": "https://graph.facebook.com/v18.0/{account-id}/ads",
            "method": "POST",
            "validation": "creative 需要有效的 object_story_spec"
          }
        ],
        "error_handling": {
          "613": "AdSet 参数错误，检查 targeting 格式",
          "2200": "Campaign objective 不支持此优化目标",
          "800": "权限不足，检查 Account Permission"
        }
      },
      "source": "api_test",
      "source_ref": "Meta Marketing API v18.0",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z",
      "tags": ["meta", "workflow", "creation", "campaign-adset-ad"],
      "metadata": {"verified": true, "test_count": 30},
      "confidence": 1.0,
      "usage_count": 0
