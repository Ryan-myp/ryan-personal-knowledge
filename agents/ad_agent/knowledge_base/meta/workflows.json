    {
      "entry_id": "meta_campaign_objective_enum",
      "platform": "meta",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "enum_reference",
        "description": "Meta Campaign 有效 Objective 枚举值",
        "valid_values": [
          "APP_INSTALLS",
          "TRAFFIC",
          "ENGAGEMENT",
          "VIDEO_VIEWS",
          "PAGE_LIKES",
          "LEAD_GENERATION",
          "CONVERSIONS",
          "CATALOG_SALES",
          "PRODUCT_CATALOG_SALES",
          "REACH",
          "BRAND_AWARENESS",
          "OUTCOME_SALES",
          "OUTCOME_AWARENESS",
          "OUTCOME_CONVERSIONS"
        ],
        "api_reference": "https://developers.facebook.com/docs/marketing-api/reference/adaccount/campaigns",
        "notes": [
          "不同 objective 对应不同的 optimization_goal 选项",
          "部分 objective 需要特殊权限（如 LEAD_GENERATION）",
          "OBJECTIVE_SALES 是较新的统一转化目标"
        ]
      },
      "description": "Meta Campaign Objective 有效枚举值",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "meta_optimization_goal_mapping",
      "platform": "meta",
      "knowledge_type": "CONSTRAINT",
      "content": {
        "type": "mapping_rule",
        "description": "Campaign Objective → AdSet Optimization Goal 映射关系",
        "mappings": [
          {"objective": "APP_INSTALLS", "allowed_optimization_goals": ["APP_INSTALLS", "APP_EVENTS"]},
          {"objective": "TRAFFIC", "allowed_optimization_goals": ["LINK_CLICKS", "REACH"]},
          {"objective": "ENGAGEMENT", "allowed_optimization_goals": ["POST_ENGAGEMENT", "MESSAGES", "IMPRESSIONS"]},
          {"objective": "CONVERSIONS", "allowed_optimization_goals": ["OFFSITE_CONVERSIONS"]},
          {"objective": "LEAD_GENERATION", "allowed_optimization_goals": ["LEAD_INTENT", "SIGN_UP"]},
          {"objective": "PRODUCT_CATALOG_SALES", "allowed_optimization_goals": ["CATALOG_SALES"]}
        ],
        "validation_error": "CAMPAIGN_OPTIMIZATION_GOAL_UNSUPPORTED_BY_OFFSITE_CONVERSIONS_QUALITY_RANK"
      },
      "description": "Campaign Objective 与 AdSet Optimization Goal 的映射约束",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "meta_targeting_structure",
      "platform": "meta",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "parameter_definition",
        "description": "Meta Targeting 参数结构",
        "structure": {
          "geo_locations": {
            "countries": ["ISO 3166-1 alpha-2 国家代码"],
            "locations": [{"country": "US", "regions": [{"id": "region_id", "name": "Region Name"}]}]
          },
          "targeting": {
            "age_min": 18,
            "age_max": 65,
            "genders": [1, 2],
            "interests": [{"id": "interest_id", "name": "Interest Name"}],
            "behaviors": [{"id": "behavior_id", "name": "Behavior Name"}]
          }
        },
        "format_note": "targeting 参数必须是 JSON 字符串，使用 urllib.parse.quote()",
        "api_reference": "https://developers.facebook.com/docs/marketing-api/targeting"
      },
      "description": "Meta Targeting 参数结构和格式要求",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "meta_special_ad_categories",
      "platform": "meta",
      "knowledge_type": "CONSTRAINT",
      "content": {
        "type": "constraint_rule",
        "description": "特殊广告类别限制",
        "valid_values": ["NONE", "EMPLOYMENT", "HOUSING", "CREDIT", "ISSUES_ELECTIONS_POLITICS"],
        "restrictions": {
          "EMPLOYMENT": {"no_age_targeting": true, "no_gender_targeting": true, "applicable_regions": ["US", "CA", "EU"]},
          "HOUSING": {"no_age_targeting": true, "no_gender_targeting": true, "applicable_regions": ["US", "CA", "EU"]},
          "CREDIT": {"no_age_targeting": true, "no_gender_targeting": true, "applicable_regions": ["US", "CA", "EU"]}
        },
        "notes": ["设置特殊广告类别后，不能使用年龄和性别定向", "仅适用于美国、加拿大、欧盟等地区"]
      },
      "description": "Meta 特殊广告类别及其限制",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    }
  ]
