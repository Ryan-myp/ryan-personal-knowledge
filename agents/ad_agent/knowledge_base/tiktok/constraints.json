        "test_cases": 20
      },
      "confidence": 1.0,
      "usage_count": 0
    },
    {
      "entry_id": "tiktok_adgroup_to_ad_creative_constraint",
      "knowledge_type": "constraint",
      "platform": "tiktok",
      "content": {
        "source_level": "ad_group",
        "target_level": "ad",
        "description": "AdGroup promotion_type 限制 Ad 素材类型",
        "rules": [
          {
            "condition": {
              "promotion_type": "APP_ANDROID"
            },
            "effect": {
              "required_creative_types": [
                "VIDEO"
              ],
              "required_fields": [
                "app_id",
                "deep_link"
              ]
            },
            "description": "Android App 推广需要视频素材和 App ID"
          },
          {
            "condition": {
              "promotion_type": "WEBSITE"
            },
            "effect": {
              "required_creative_types": [
                "IMAGE",
                "VIDEO"
              ],
              "required_fields": [
                "landing_url"
              ]
            },
            "description": "网站推广需要落地页 URL"
          },
          {
            "condition": {
              "promotion_type": "CATALOG"
            },
            "effect": {
              "required_creative_types": [
                "CAROUSEL"
              ],
              "required_fields": [
                "product_set_id"
              ]
            },
            "description": "目录推广需要商品集 ID"
          }
        ]
      },
      "source": "api_test",
