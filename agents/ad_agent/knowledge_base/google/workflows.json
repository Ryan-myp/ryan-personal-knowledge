      "entry_id": "google_campaign_types",
      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "enum_reference",
        "description": "Google Ads 广告系列类型枚举",
        "valid_values": {
          "SEARCH": {
            "description": "搜索广告",
            "sub_types": ["SEARCH_STANDARD", "SEARCH_DYNAMIC_ADS"]
          },
          "SHOPPING": {
            "description": "购物广告",
            "sub_types": ["SHOPPING_SALES", "SHOPPING_PRODUCT_ADS"]
          },
          "DISPLAY": {
            "description": "展示广告",
            "sub_types": ["DISPLAY_STANDARD", "DISPLAY_PERFORMANCE"]
          },
          "VIDEO": {
            "description": "视频广告",
            "sub_types": ["VIDEO_VIEW", "VIDEO_ENGAGEMENT"]
          },
          "MULTI_CHANNEL": {
            "description": "全渠道广告（App 广告）",
            "sub_types": ["APP_CAMPAIGN"]
          },
          "PERFORMANCE_MAX": {
            "description": "效果最大化广告",
            "sub_types": []
          }
        },
        "api_reference": "https://developers.google.com/google-ads/api/reference/rpc/v25/AdvertisingChannelTypeEnum"
      },
      "description": "Google Ads 广告系列类型定义",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:29:00Z"
    },
