    {
      "entry_id": "google_search_campaign_workflow",
      "platform": "google",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "create_search_campaign",
        "description": "Google Ads 搜索广告系列创建流程",
        "steps": [
          {
            "step": 1,
            "action": "create_campaign",
            "level": "campaign",
            "required_params": [
              "customer_id",
              "name",
              "advertising_channel_type",
              "status",
              "campaign_budget",
              "bidding_strategy",
              "contains_eu_political_advertising"
            ],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/search",
            "notes": [
              "必须设置 contains_eu_political_advertising（必需字段）",
              "使用 client.enums 获取枚举值"
            ]
          },
          {
            "step": 2,
            "action": "create_ad_group",
            "level": "ad_group",
            "required_params": [
              "campaign",
              "name",
              "status"
            ],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/ad-groups"
          },
          {
            "step": 3,
            "action": "create_keyword",
            "level": "ad_group_criterion",
            "required_params": [
              "ad_group",
              "keyword",
              "cpc_bid_micros"
            ],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/keywords"
          },
          {
            "step": 4,
            "action": "create_ad",
            "level": "ad",
            "required_params": [
              "ad_group",
              "final_urls",
              "headlines",
              "descriptions"
            ],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/responsive-search-ads"
          }
        ],
        "error_handling": {
          "REQUIRED": "缺少必需字段，通常是 contains_eu_political_advertising",
          "INVALID_ENUM_VALUE": "枚举值不正确，使用 client.enums 获取"
        }
      },
      "source": "official_docs",
      "source_ref": "https://developers.google.cn/google-ads/api/samples/add-dynamic-search-ads",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:29:00Z",
