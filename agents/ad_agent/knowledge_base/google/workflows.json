      "entry_id": "google_bidding_strategies",
      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "enum_reference",
        "description": "Google Ads 出价策略枚举",
        "valid_values": [
          "TARGET_CPA",
          "TARGET_ROAS",
          "MAXIMIZE_CONVERSIONS",
          "MAXIMIZE_CONVERSION_VALUE",
          "MANUAL_CPC",
          "MANUAL_CPM"
        ],
        "notes": [
          "智能出价策略（如 TARGET_CPA）需要转化数据",
          "不同广告系列类型支持不同的出价策略"
        ],
        "api_reference": "https://developers.google.com/google-ads/api/docs/bidding/target-cpa"
      },
      "description": "Google Ads 出价策略定义",
