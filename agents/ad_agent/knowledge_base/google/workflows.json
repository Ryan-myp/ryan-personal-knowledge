    {
      "entry_id": "google_campaign_creation_official",
      "platform": "google",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "create_campaign_official_example",
        "description": "Google Ads Campaign 创建官方示例代码（来自 developers.google.cn）",
        "official_source": "https://developers.google.cn/google-ads/api/samples/add-dynamic-search-ads",
        "key_finding": "必须使用 client.enums 获取枚举值，不能直接导入枚举类",
        "correct_pattern": \"\"\"
# ✅ 正确方式：使用 client.enums 获取枚举值
from google.ads.googleads.client import GoogleAdsClient

client = GoogleAdsClient.load_from_storage('config.yaml')

campaign.contains_eu_political_advertising = \
    client.enums.EuPoliticalAdvertisingStatusEnum.DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING

campaign.advertising_channel_type = \
    client.enums.AdvertisingChannelTypeEnum.SEARCH

campaign.status = client.enums.CampaignStatusEnum.PAUSED
\"\"\",
        "wrong_patterns": [
          {
            "error": "ImportError: cannot import name 'AdvertisingChannelType'",
            "cause": "错误导入方式",
            "example": "from google.ads.googleads.v25.enums.types.advertising_channel_type import AdvertisingChannelType"
          },
          {
            "error": "TypeError: Expected an int, got a boolean",
            "cause": "使用布尔值代替枚举",
            "example": "campaign.contains_eu_political_advertising = False"
          },
          {
            "error": "INVALID_ARGUMENT: The required field was not present",
            "cause": "proto3 零值省略，枚举值 0 不会被序列化",
            "example": "campaign.contains_eu_political_advertising = 0"
          }
        ],
        "code_example_search_campaign": \"\"\"
def create_search_campaign(client, customer_id, budget_resource_name):
    campaign_service = client.get_service('CampaignService')
    campaign_operation = client.get_type('CampaignOperation')
    campaign = campaign_operation.create
    
    campaign.name = f'Interplanetary Cruise #{uuid4()}'
    campaign.advertising_channel_type = client.enums.AdvertisingChannelTypeEnum.SEARCH
    campaign.status = client.enums.CampaignStatusEnum.PAUSED
    campaign.campaign_budget = budget_resource_name
    
    # Required: EU political advertising declaration
    campaign.contains_eu_political_advertising = \
        client.enums.EuPoliticalAdvertisingStatusEnum.DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING
    
    # Enable DSAs
    campaign.dynamic_search_ads_setting.domain_name = 'example.com'
    campaign.dynamic_search_ads_setting.language_code = 'en'
    
    response = campaign_service.mutate_campaigns(
        customer_id=customer_id,
        operations=[campaign_operation]
    )
    return response.results[0].resource_name
\"\"\",
        "code_example_app_campaign": \"\"\"
def create_app_campaign(client, customer_id, budget_resource_name):
    campaign_operation = client.get_type('CampaignOperation')
    campaign = campaign_operation.create
    
    campaign.name = f'Interplanetary Cruise App #{uuid4()}'
    campaign.campaign_budget = budget_resource_name
    campaign.status = client.enums.CampaignStatusEnum.PAUSED
    campaign.advertising_channel_type = client.enums.AdvertisingChannelTypeEnum.MULTI_CHANNEL
    campaign.advertising_channel_sub_type = client.enums.AdvertisingChannelSubTypeEnum.APP_CAMPAIGN
    
    # Target CPA $1 per install
    campaign.target_cpa.target_cpa_micros = 1000000
    
    # App settings
    campaign.app_campaign_setting.app_id = 'com.google.android.apps.adwords'
    campaign.app_campaign_setting.app_store = \
        client.enums.AppCampaignAppStoreEnum.GOOGLE_APP_STORE
    campaign.app_campaign_setting.bidding_strategy_goal_type = \
        client.enums.AppCampaignBiddingStrategyGoalTypeEnum.OPTIMIZE_INSTALLS_TARGET_INSTALL_COST
    
    # Required: EU political advertising declaration
    campaign.contains_eu_political_advertising = \
        client.enums.EuPoliticalAdvertisingStatusEnum.DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING
    
    response = campaign_service.mutate_campaigns(
        customer_id=customer_id,
        operations=[campaign_operation]
    )
    return response.results[0].resource_name
\"\"\",
        "api_reference": "https://developers.google.cn/google-ads/api/samples?hl=zh-cn"
      },
