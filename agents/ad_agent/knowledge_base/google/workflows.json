    {
      "entry_id": "google_search_campaign_workflow",
      "platform": "google",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "create_search_campaign",
        "description": "Google Ads 搜索广告系列创建流程",
        "steps": [
          {
            "step": 1,
            "action": "create_campaign",
            "level": "campaign",
            "required_params": ["customer_id", "name", "type", "network_settings", "shopping_setting"],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/search",
            "notes": ["Shopping 类型需要 shopping_setting", "Search 类型需要 advertising_channel_type"]
          },
          {
            "step": 2,
            "action": "create_ad_group",
            "level": "ad_group",
            "required_params": ["campaign", "name", "cpc_bid_ceiling_micros"],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/ad-groups"
          },
          {
            "step": 3,
            "action": "create_keyword",
            "level": "ad_group_criterion",
            "required_params": ["ad_group", "keyword", "cpc_bid_micros"],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/keywords"
          },
          {
            "step": 4,
            "action": "create_ad",
            "level": "ad",
            "required_params": ["ad_group", "final_urls", "headlines", "descriptions"],
            "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/responsive-search-ads"
          }
        ],
        "error_handling": {
          "5": "API 版本或认证问题",
          "77": "广告系列类型不支持",
          "180": "预算冲突"
        }
      },
      "source": "official_docs",
      "source_ref": "https://developers.google.com/google-ads/api/docs/campaigns",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z",
      "tags": ["google", "workflow", "search", "campaign"],
      "metadata": {"verified": false},
      "confidence": 0.8,
      "usage_count": 0
    },
    {
      "entry_id": "google_campaign_types",
      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "enum_reference",
        "description": "Google Ads 广告系列类型枚举",
        "valid_values": {
          "SEARCH": {
            "description": "搜索广告",
            "sub_types": ["SEARCH_STANDARD", "SEARCH_DYNAMIC_ADS"]
          },
          "SHOPPING": {
            "description": "购物广告",
            "sub_types": ["SHOPPING_SALES", "SHOPPING_PRODUCT_ADS", "SHOPPING_REVIEW_ADS"]
          },
          "DISPLAY": {
            "description": "展示广告",
            "sub_types": ["DISPLAY_STANDARD", "DISPLAY_PERFORMANCE"]
          },
          "VIDEO": {
            "description": "视频广告",
            "sub_types": ["VIDEO_VIEW", "VIDEO_ENGAGEMENT"]
          },
          "APP": {
            "description": "应用广告",
            "sub_types": ["APP_INSTALLS", "APP_engagement"]
          },
          "MAXIMIZE": {
            "description": "智能广告系列",
            "sub_types": ["PERFORMANCE_MAX"]
          }
        },
        "api_reference": "https://developers.google.com/google-ads/api/reference/rpc/v18/Campaign.Type"
      },
      "description": "Google Ads 广告系列类型定义",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_bidding_strategies",
      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "enum_reference",
        "description": "Google Ads 出价策略枚举",
        "valid_values": [
          "TARGET_CPA",
          "TARGET_ROAS",
          "MAXIMIZE_CONVERSIONS",
          "MAXIMIZE_CONVERSION_VALUE",
          "TARGET_OUTCOME_ROAS",
          "TARGET_SPEND",
          "MANUAL_CPC",
          "MANUAL_CPM",
          "TARGET_CPV",
          "TARGET_OCPM",
          "TARGET_CPM",
          "NO_BIDDING"
        ],
        "notes": [
          "智能出价策略（如 TARGET_CPA）需要转化数据",
          "MANUAL_CPC 需要设置 bid_crest_micros",
          "不同广告系列类型支持不同的出价策略"
        ],
        "api_reference": "https://developers.google.com/google-ads/api/docs/bidding/target-cpa"
      },
      "description": "Google Ads 出价策略定义",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_budget_units",
      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "unit_reference",
        "description": "Google Ads 预算单位说明",
        "unit": "micros（百万分之一）",
        "examples": {
          "daily_budget_100_usd": 100000000,
          "daily_budget_50_usd": 50000000,
          "cpc_bid_1_usd": 1000000,
          "cpc_bid_0.50_usd": 500000
        },
        "formula": "美元金额 × 1,000,000 = micros",
        "api_reference": "https://developers.google.com/google-ads/api/docs/concepts/budget"
      },
      "description": "Google Ads 金额字段单位为 micros",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_api_authentication",
      "platform": "google",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "authentication_flow",
        "description": "Google Ads API 认证流程",
        "steps": [
          {
            "step": 1,
            "action": "get_refresh_token",
            "description": "通过 OAuth2 获取 refresh_token"
          },
          {
            "step": 2,
            "action": "load_developer_token",
            "description": "加载 Developer Token（需要申请）"
          },
          {
            "step": 3,
            "action": "initialize_client",
            "description": "使用 google-ads.yaml 配置客户端"
          },
          {
            "step": 4,
            "action": "execute_query",
            "description": "使用 GAQL 查询数据"
          }
        ],
        "config_file": "~/.google/ads/google_ads.yaml",
        "config_format": {
          "developer_token": "your_developer_token",
          "client_id": "your_client_id",
          "client_secret": "your_client_secret",
          "refresh_token": "your_refresh_token",
          "login_customer_id": "your_customer_id"
        },
        "api_reference": "https://developers.google.com/google-ads/api/docs/start"
      },
      "description": "Google Ads API 认证配置流程",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_paid_search_hierarchy",
      "platform": "google",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "create_paid_search_campaign",
        "description": "付费搜索广告层级创建流程",
        "hierarchy": [
          {
            "level": "campaign",
            "required_fields": ["name", "type", "advertising_channel_type", "status"],
            "notes": ["type=SEARCH, advertising_channel_type=SEARCH_STANDARD"]
          },
          {
            "level": "ad_group",
            "required_fields": ["campaign", "name", "status"],
            "notes": ["需要设置 cpc_bid_ceiling_micros 或 bidding_strategy"]
          },
          {
            "level": "ad_group_criterion",
            "required_fields": ["ad_group", "keyword"],
            "notes": ["需要设置 bid_micros 和 match_type"]
          },
          {
            "level": "ad",
            "required_fields": ["ad_group", "final_urls", "headlines", "descriptions"],
            "notes": ["Responsive Search Ad 至少需要 3 headlines + 2 descriptions"]
          }
        ],
        "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/create-search-ads"
      },
      "description": "Google Ads 搜索广告层级结构",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    }
  ]
}
