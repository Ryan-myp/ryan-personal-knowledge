      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "unit_reference",
        "description": "Google Ads 预算单位说明",
        "unit": "micros（百万分之一）",
        "examples": {
          "daily_budget_100_usd": 100000000,
          "daily_budget_50_usd": 50000000,
          "cpc_bid_1_usd": 1000000,
          "cpc_bid_0.50_usd": 500000
        },
        "formula": "美元金额 × 1,000,000 = micros",
        "api_reference": "https://developers.google.com/google-ads/api/docs/concepts/budget"
      },
      "description": "Google Ads 金额字段单位为 micros",
