    {
      "entry_id": "google_paid_search_hierarchy",
      "platform": "google",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "create_paid_search_campaign",
        "description": "付费搜索广告层级创建流程",
        "hierarchy": [
          {
            "level": "campaign",
            "required_fields": [
              "name",
              "advertising_channel_type",
              "status",
              "campaign_budget",
              "bidding_strategy",
              "contains_eu_political_advertising"
            ],
            "notes": [
              "必须设置 contains_eu_political_advertising",
              "使用 client.enums 获取枚举值"
            ]
          },
          {
            "level": "ad_group",
            "required_fields": [
              "campaign",
              "name",
              "status"
            ],
            "notes": [
              "需要设置 cpc_bid_ceiling_micros 或 bidding_strategy"
            ]
          },
          {
            "level": "ad_group_criterion",
            "required_fields": [
              "ad_group",
              "keyword"
            ],
            "notes": [
              "需要设置 bid_micros 和 match_type"
            ]
          },
          {
            "level": "ad",
            "required_fields": [
              "ad_group",
              "final_urls",
              "headlines",
              "descriptions"
            ],
            "notes": [
              "Responsive Search Ad 至少需要 3 headlines + 2 descriptions"
            ]
          }
        ],
        "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/create-search-ads"
      },
      "description": "Google Ads 搜索广告层级结构",
