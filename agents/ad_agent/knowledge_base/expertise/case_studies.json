      "content": {
        "title": "电商客户 ROAS 优化案例",
        "description": "通过精细化定向和素材优化，将 ROAS 从 2.5 提升至 4.8",
        "business_type": "ecommerce",
        "challenge": "初期 ROAS 仅 2.5，远低于目标 4.0",
        "solution": [
          "拆分 AdGroup 按产品类别",
          "为高价值产品设置独立 Campaign",
          "使用动态商品广告（DPA）",
          "优化素材展示产品卖点"
        ],
        "results": {
          "roas_before": 2.5,
          "roas_after": 4.8,
          "improvement": "92%"
        },
        "key_learnings": [
          "细分受众比泛定向效果更好",
          "动态素材能显著提升 CTR",
          "持续 A/B 测试是优化的关键"
        ]
      },
