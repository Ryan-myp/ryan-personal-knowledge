    {
      "entry_id": "google_campaign_budget_constraint",
      "platform": "google",
      "knowledge_type": "CONSTRAINT",
      "content": {
        "type": "constraint_rule",
        "description": "Google Ads 预算约束规则",
        "rules": [
          {
            "condition": {
              "budget_type": "DAILY"
            },
            "effect": {
              "min_amount_micros": 1000000,
              "min_amount_usd": 1.00,
              "currency": "micros"
            },
            "description": "日预算最低 $1 USD"
          },
          {
            "condition": {
              "campaign_type": "SEARCH"
            },
            "effect": {
              "bidding_strategy_required": true,
              "cpc_bid_ceiling_required": false
            },
            "description": "搜索广告需要设置出价策略"
          }
        ]
      },
      "description": "Google Ads 预算约束规则",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_ad_group_bid_constraint",
      "platform": "google",
      "knowledge_type": "CONSTRAINT",
      "content": {
        "type": "constraint_rule",
        "description": "Google Ads 广告组出价约束",
        "rules": [
          {
            "condition": {
              "bidding_strategy_type": "MANUAL_CPC"
            },
            "effect": {
              "required_fields": ["cpc_bid_ceiling_micros"],
              "min_cpc_micros": 100000,
              "min_cpc_usd": 0.01
            },
            "description": "手动 CPC 需要设置 cpc_bid_ceiling_micros，最低 $0.01"
          },
          {
            "condition": {
              "bidding_strategy_type": "TARGET_CPA"
            },
            "effect": {
              "required_fields": ["target_cpa_micros"],
              "min_cpa_micros": 1000000,
              "min_cpa_usd": 1.00,
              "conversion_data_required": true
            },
            "description": "目标 CPA 需要转化历史数据，最低 $1.00"
          }
        ]
      },
      "description": "Google Ads 广告组出价约束",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_keyword_match_type",
      "platform": "google",
      "knowledge_type": "CONSTRAINT",
      "content": {
        "type": "constraint_rule",
        "description": "Google Ads 关键词匹配类型约束",
        "valid_match_types": [
          "EXACT",
          "PHRASE",
          "BROAD",
          "BROAD_MODIFIER"
        ],
        "examples": {
          "exact": "[running shoes]",
          "phrase": "\"running shoes\"",
          "broad": "running shoes",
          "broad_modifier": "+running +shoes"
        },
        "notes": [
          "BROAD_MODIFIER 已弃用，建议使用 PHRASE 或 EXACT",
          "默认使用 EXACT 匹配"
        ],
        "api_reference": "https://developers.google.com/google-ads/api/docs/campaigns/keywords"
      },
      "description": "Google Ads 关键词匹配类型定义",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_ad_strength",
      "platform": "google",
      "knowledge_type": "CONSTRAINT",
      "content": {
        "type": "validation_rule",
        "description": "Google Ads 响应式搜索广告强度要求",
        "requirements": {
          "headlines": {
            "min_count": 3,
            "max_count": 15,
            "min_length": 30,
            "max_length": 30
          },
          "descriptions": {
            "min_count": 1,
            "max_count": 4,
            "min_length": 10,
            "max_length": 100
          }
        },
        "strength_levels": [
          "POOR",
          "GOOD",
          "AVERAGE",
          "EXCELLENT"
        ],
        "notes": [
          "至少需要 3 个标题 + 2 个描述才能提交审核",
          "标题和描述长度单位是字符数"
        ]
      },
      "description": "Google Ads 响应式搜索广告强度要求",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    },
    {
      "entry_id": "google_customer_id_format",
      "platform": "google",
      "knowledge_type": "PARAMETER",
      "content": {
        "type": "format_rule",
        "description": "Google Ads 客户 ID 格式",
        "format": "整数字符串，不含连字符",
        "examples": ["9055507554", "1234567890"],
        "notes": [
          "customer_id 在 API 中是字符串类型",
          "实际值是去掉连字符的数字"
        ]
      },
      "description": "Google Ads 客户 ID 格式说明",
      "created_at": "2026-08-24T19:00:00Z",
      "updated_at": "2026-08-24T19:00:00Z"
    }
  ]
}
