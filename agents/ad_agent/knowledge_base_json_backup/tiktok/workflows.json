        "tiktok",
        "workflow",
        "adgroup"
      ],
      "metadata": {
        "verified": true
      },
      "confidence": 1.0,
      "usage_count": 0
    },
    {
      "entry_id": "tiktok_api_v1_3_app_adgroup_limitation",
      "platform": "tiktok",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "api_limitation",
        "api_version": "v1.3",
        "limitation": "API v1.3 无法创建 APP_ANDROID AdGroup",
        "details": [
          "MANUAL Campaign 不支持 APP_ANDROID promotion_type",
          "UPGRADED_SMART_PLUS Campaign 不支持通过 API 创建 AdGroup",
          "所有 MANUAL objective_type 都无法创建 APP_ANDROID AdGroup",
          "错误信息包括：'Invalid optimization goal', 'Bid Mode value is invalid', 'Accelerated delivery under No-Bid strategy is not supported'"
        ],
        "workaround": [
          "方案 A: 使用 TikTok 广告后台手动创建 App Campaign",
          "方案 B: 联系 TikTok 申请 API v2.0 权限",
          "方案 C: 使用 WEBSITE promotion_type 代替（通过 API）"
        ],
        "recommendation": "对于 APP 推广，建议使用 TikTok 广告后台手动创建 Campaign 和 AdGroup，或通过 TikTok 销售团队申请 API 权限升级"
      },
      "description": "TikTok API v1.3 限制：无法通过 API 创建 APP_ANDROID AdGroup",
      "created_at": "2026-08-24T18:26:00Z",
      "updated_at": "2026-08-24T18:26:00Z"
    },
    {
      "entry_id": "tiktok_website_adgroup_correct_params",
      "platform": "tiktok",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "api_workflow",
        "description": "WEBSITE promotion_type 的正确参数组合",
        "parameters": {
          "campaign": {
            "objective_type": "TRAFFIC",
            "campaign_automation_type": "MANUAL"
          },
          "adgroup": {
            "promotion_type": "WEBSITE",
            "billing_event": "OCPM",
            "optimization_goal": "TRAFFIC_LANDING_PAGE_VIEW",
            "bid_type": "BID_TYPE_CUSTOM",
            "conversion_bid_price": 100
          }
        },
        "notes": [
          "不能使用 BID_TYPE_NO_BID（不支持）",
          "不能使用 CPC billing_event（必须用 OCPM）",
          "conversion_bid_price 单位是分（cents）"
        ]
      },
      "description": "WEBSITE AdGroup 正确参数",
      "created_at": "2026-08-24T18:35:00Z",
      "updated_at": "2026-08-24T18:35:00Z"
    },
    {
      "entry_id": "tiktok_smart_plus_campaign_correct_params",
      "platform": "tiktok",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "api_workflow",
        "description": "SMART+ Campaign 正确创建参数",
        "parameters": {
          "campaign": {
            "objective_type": "APP_PROMOTION",
            "app_promotion_type": "APP_RETARGETING",
            "campaign_type": "REGULAR_CAMPAIGN",
            "budget_optimize_on": true,
            "budget_mode": "BUDGET_MODE_DYNAMIC_DAILY_BUDGET",
            "budget": 50
          },
          "adgroup": {
            "promotion_type": "APP_ANDROID",
            "optimization_goal": "IN_APP_EVENT",
            "optimization_event": "ACTIVE_PAY",
            "bid_type": "BID_TYPE_NO_BID",
            "deep_bid_type": "AEO",
            "billing_event": "OCPM",
            "audience_type": "NEW_CUSTOM_AUDIENCE"
          },
          "ad": {
            "identity_type": "BC_AUTH_TT",
            "ad_format": "SINGLE_VIDEO",
            "tiktok_item_id": "Spark视频ID"
          }
        },
        "notes": [
          "使用标准 campaign/create 端点",
          "app_promotion_type 是必需字段",
          "budget_optimize_on=true 启用 CBO",
          "audience_type=NEW_CUSTOM_AUDIENCE 用于 App Retargeting"
        ]
      },
      "description": "SMART+ Campaign 正确创建参数",
      "created_at": "2026-08-24T18:55:00Z",
      "updated_at": "2026-08-24T18:55:00Z"
    },
    {
      "entry_id": "tiktok_ad_create_response_structure",
      "platform": "tiktok",
      "knowledge_type": "WORKFLOW",
      "content": {
        "type": "api_reference",
        "description": "TikTok Ad 创建响应结构",
        "response": {
          "code": 0,
          "message": "OK",
          "data": {
            "ad_ids": [
              "ad_id_value"
            ],
            "need_audit": false,
            "creatives": [
              {
                "ad_id": "ad_id_value"
              }
            ]
          }
        },
        "extraction": {
          "correct": [
            "ad_id = result.get('data', {}).get('ad_ids', [])[0]",
            "ad_id = result.get('data', {}).get('creatives', [{}])[0].get('ad_id')"
          ],
          "incorrect": [
            "ad_id = result.get('data', {}).get('ad_id')  # 错误：字段不存在"
          ]
        }
      },
      "description": "TikTok Ad 创建响应中 ad_id 在 ad_ids 数组里",
      "created_at": "2026-08-24T18:57:00Z",
      "updated_at": "2026-08-24T18:57:00Z"
    }
  ]
}