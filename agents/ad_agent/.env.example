# Copy this file to .env and fill in the values locally.
# The .env file is ignored by Git and is loaded automatically by api_server.py.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.sapiens.ai/v1
LLM_MODEL=agnes-3.0-flash

# Shared no-login mode: all reachable clients use one identity and workspace.
# Enable only on a trusted LAN/VPN; never expose this service directly to the public internet.
AD_AGENT_ALLOW_UNAUTHENTICATED=1

# Optional service settings:
# Ignored while AD_AGENT_ALLOW_UNAUTHENTICATED=1.
# AD_AGENT_API_KEY=
# AD_AGENT_DB_PATH=
# Database defaults to SQLite (single process). For shared multi-instance
# deployment, configure MySQL instead; the same PersistenceBackend is used.
# AD_AGENT_DB_BACKEND=mysql
# AD_AGENT_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ad_agent?charset=utf8mb4
# AD_AGENT_DB_POOL_SIZE=5
# AD_AGENT_DB_MAX_OVERFLOW=10
# AD_AGENT_DB_CONNECT_TIMEOUT=10
# AD_AGENT_SERVICE_TENANT=default
