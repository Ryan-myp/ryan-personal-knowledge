{
  "id": "google-ads.demand_gen_product",
  "version": "1.0.0",
  "provider": "google-ads",
  "ad_format": "DEMAND_GEN_PRODUCT",
  "title": "Google Demand Gen 商品广告",
  "description": "使用 Merchant Center 商品源配置 Demand Gen 商品广告的文案、Logo 和行动号召。",
  "match_terms": ["商品广告", "商品推广", "product ad", "product"],
  "selector": {"dimension": "ad_format", "field": "campaign.advertising_channel_type", "values": ["DEMAND_GEN"], "label": "Google 广告系列类型", "options": [{"value": "DEMAND_GEN", "label": "Demand Gen"}]},
  "tools": ["google_create_campaign", "google_create_specialized_ad_group", "google_create_demand_gen_product_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "google_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.contains_eu_political_advertising", "tool_ref": "google_create_campaign.contains_eu_political_advertising", "label": "欧盟政治广告声明", "required": true, "source": "enum", "options": ["DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING", "CONTAINS_EU_POLITICAL_ADVERTISING"]},
    {"path": "campaign.advertising_channel_type", "tool_ref": "google_create_campaign.advertising_channel_type", "label": "广告系列类型（已根据入口匹配）", "required": true, "source": "enum", "options": ["DEMAND_GEN"], "presentation": "derived_readonly"},
    {"path": "campaign.bidding_strategy", "tool_ref": "google_create_campaign.bidding_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["MAXIMIZE_CONVERSIONS", "MAXIMIZE_CONVERSION_VALUE", "TARGET_CPA", "TARGET_ROAS"]},
    {"path": "campaign.target_cpa_micros", "tool_ref": "google_create_campaign.target_cpa_micros", "label": "目标 CPA（微单位）", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}},
    {"path": "campaign.target_roas", "tool_ref": "google_create_campaign.target_roas", "label": "目标 ROAS", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}},
    {"path": "campaign.daily_budget", "tool_ref": "google_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "campaign.demand_gen_campaign_settings", "tool_ref": "google_create_campaign.demand_gen_campaign_settings", "label": "Demand Gen 广告系列设置", "required": true, "presentation": "object_editor"},
    {"path": "ad_group.name", "tool_ref": "google_create_specialized_ad_group.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.campaign_type", "tool_ref": "google_create_specialized_ad_group.campaign_type", "label": "广告组所属类型（自动匹配）", "required": true, "source": "enum", "options": ["DEMAND_GEN"], "presentation": "derived_readonly"},
    {"path": "ad_group.type", "tool_ref": "google_create_specialized_ad_group.type", "label": "广告组类型（由 Demand Gen 自动确定）", "required": true, "source": "enum", "options": ["SEARCH_STANDARD"], "presentation": "derived_readonly"},
    {"path": "ad_group.demand_gen_ad_group_settings", "tool_ref": "google_create_specialized_ad_group.demand_gen_ad_group_settings", "label": "Demand Gen 广告组版位设置", "required": true, "presentation": "object_editor"},
    {"path": "ad.name", "tool_ref": "google_create_demand_gen_product_ad.name", "label": "广告名称", "required": true},
    {"path": "ad.headline", "tool_ref": "google_create_demand_gen_product_ad.headline", "label": "商品广告标题", "required": true, "presentation": "object_editor"},
    {"path": "ad.description", "tool_ref": "google_create_demand_gen_product_ad.description", "label": "商品广告描述", "required": true, "presentation": "object_editor"},
    {"path": "ad.business_name", "tool_ref": "google_create_demand_gen_product_ad.business_name", "label": "商家名称", "required": true, "presentation": "object_editor"},
    {"path": "ad.logo_image", "tool_ref": "google_create_demand_gen_product_ad.logo_image", "label": "Logo 图片", "required": true, "source": "lookup", "lookup_tool": "google_list_assets", "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.call_to_action", "tool_ref": "google_create_demand_gen_product_ad.call_to_action", "label": "行动号召素材", "required": true, "source": "lookup", "lookup_tool": "google_list_assets", "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.final_url", "tool_ref": "google_create_demand_gen_product_ad.final_url", "label": "最终到达网址", "required": false}
  ],
  "rules": [{"id": "campaign_type_is_fixed", "when": {"field": "campaign.advertising_channel_type", "equals": "DEMAND_GEN"}, "preserve": ["campaign.advertising_channel_type", "ad_group.campaign_type"]}]
}
