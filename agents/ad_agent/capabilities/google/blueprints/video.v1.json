{
  "id": "google-ads.video",
  "version": "1.0.0",
  "provider": "google-ads",
  "ad_format": "VIDEO",
  "title": "Google Video 广告",
  "description": "按 Google Video 广告系列类型配置视频出价、广告组和 YouTube 视频素材。",
  "selector": {"dimension": "ad_format", "field": "campaign.advertising_channel_type", "values": ["VIDEO"], "label": "Google 广告系列类型", "options": [{"value": "VIDEO", "label": "视频"}]},
  "tools": ["google_create_campaign", "google_create_ad_group", "google_create_video_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "google_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.contains_eu_political_advertising", "tool_ref": "google_create_campaign.contains_eu_political_advertising", "label": "欧盟政治广告声明", "required": true, "source": "enum", "options": ["DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING", "CONTAINS_EU_POLITICAL_ADVERTISING"]},
    {"path": "campaign.advertising_channel_type", "tool_ref": "google_create_campaign.advertising_channel_type", "label": "广告系列类型（已根据入口匹配）", "required": true, "source": "enum", "options": ["VIDEO"], "presentation": "derived_readonly"},
    {"path": "campaign.bidding_strategy", "tool_ref": "google_create_campaign.bidding_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["MAXIMIZE_CONVERSIONS", "MANUAL_CPV", "TARGET_CPV", "TARGET_CPA"], "option_labels": {"MAXIMIZE_CONVERSIONS": "最大化转化次数", "MANUAL_CPV": "人工 CPV", "TARGET_CPV": "目标 CPV", "TARGET_CPA": "目标 CPA"}},
    {"path": "campaign.target_cpv_micros", "tool_ref": "google_create_campaign.target_cpv_micros", "label": "目标 CPV", "visible_when": {"field": "campaign.bidding_strategy", "in": ["MANUAL_CPV", "TARGET_CPV"]}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPV"}},
    {"path": "campaign.target_cpa_micros", "tool_ref": "google_create_campaign.target_cpa_micros", "label": "目标 CPA", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}},
    {"path": "campaign.daily_budget", "tool_ref": "google_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "ad_group.name", "tool_ref": "google_create_ad_group.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.type", "tool_ref": "google_create_ad_group.type", "label": "广告组类型（根据视频格式自动匹配）", "required": true, "source": "enum", "options": ["VIDEO_TRUEVIEW_IN_STREAM", "VIDEO_BUMPER", "VIDEO_NON_SKIPPABLE_IN_STREAM", "VIDEO_RESPONSIVE"], "presentation": "derived_readonly", "derived_from": "ad.video_ad_format", "derive_map": {"SKIPPABLE_IN_STREAM": "VIDEO_TRUEVIEW_IN_STREAM", "NON_SKIPPABLE_IN_STREAM": "VIDEO_NON_SKIPPABLE_IN_STREAM", "BUMPER": "VIDEO_BUMPER", "OUTSTREAM": "VIDEO_RESPONSIVE"}},
    {"path": "ad.name", "tool_ref": "google_create_video_ad.name", "label": "广告名称", "required": true},
    {"path": "ad.video_ad_format", "tool_ref": "google_create_video_ad.video_ad_format", "label": "视频广告格式", "required": true, "source": "enum", "options": ["SKIPPABLE_IN_STREAM", "NON_SKIPPABLE_IN_STREAM", "BUMPER", "OUTSTREAM"], "option_labels": {"SKIPPABLE_IN_STREAM": "可跳过插播", "NON_SKIPPABLE_IN_STREAM": "不可跳过插播", "BUMPER": "导视广告（Bumper）", "OUTSTREAM": "信息流外展示"}},
    {"path": "ad.video_id", "tool_ref": "google_create_video_ad.video_id", "label": "YouTube 视频 ID", "required": true},
    {"path": "ad.final_url", "tool_ref": "google_create_video_ad.final_url", "label": "最终到达网址", "required": true}
  ],
  "rules": [{"id": "video_format_changed", "when": {"field": "ad.video_ad_format", "changed": true}, "preserve": ["ad.video_id", "ad.final_url"]}]
}
