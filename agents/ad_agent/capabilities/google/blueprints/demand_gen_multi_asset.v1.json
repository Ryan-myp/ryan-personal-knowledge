{
  "id": "google-ads.demand_gen_multi_asset",
  "version": "1.0.0",
  "provider": "google-ads",
  "ad_format": "DEMAND_GEN_MULTI_ASSET",
  "title": "Google Demand Gen 多素材广告",
  "description": "先配置 Demand Gen 广告系列和广告组，再选择文本、图片和可复用素材资产。",
  "match_terms": ["多素材", "多素材广告", "multi asset", "multi-asset", "multi_asset"],
  "selector": {"dimension": "ad_format", "field": "campaign.advertising_channel_type", "values": ["DEMAND_GEN"], "label": "Google 广告系列类型", "options": [{"value": "DEMAND_GEN", "label": "Demand Gen"}]},
  "tools": ["google_create_campaign", "google_create_specialized_ad_group", "google_create_demand_gen_multi_asset_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "google_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.contains_eu_political_advertising", "tool_ref": "google_create_campaign.contains_eu_political_advertising", "label": "欧盟政治广告声明", "required": true, "source": "enum", "options": ["DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING", "CONTAINS_EU_POLITICAL_ADVERTISING"]},
    {"path": "campaign.advertising_channel_type", "tool_ref": "google_create_campaign.advertising_channel_type", "label": "广告系列类型（已根据入口匹配）", "required": true, "source": "enum", "options": ["DEMAND_GEN"], "presentation": "derived_readonly"},
    {"path": "campaign.bidding_strategy", "tool_ref": "google_create_campaign.bidding_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["MAXIMIZE_CONVERSIONS", "MAXIMIZE_CONVERSION_VALUE", "TARGET_CPA", "TARGET_ROAS"], "option_labels": {"MAXIMIZE_CONVERSIONS": "最大化转化次数", "MAXIMIZE_CONVERSION_VALUE": "最大化转化价值", "TARGET_CPA": "目标 CPA", "TARGET_ROAS": "目标 ROAS"}},
    {"path": "campaign.target_cpa_micros", "tool_ref": "google_create_campaign.target_cpa_micros", "label": "目标 CPA（微单位）", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}},
    {"path": "campaign.target_roas", "tool_ref": "google_create_campaign.target_roas", "label": "目标 ROAS", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}},
    {"path": "campaign.daily_budget", "tool_ref": "google_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "campaign.demand_gen_campaign_settings", "tool_ref": "google_create_campaign.demand_gen_campaign_settings", "label": "Demand Gen 广告系列设置", "required": true, "presentation": "object_editor"},
    {"path": "ad_group.name", "tool_ref": "google_create_specialized_ad_group.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.campaign_type", "tool_ref": "google_create_specialized_ad_group.campaign_type", "label": "广告组所属类型（自动匹配）", "required": true, "source": "enum", "options": ["DEMAND_GEN"], "presentation": "derived_readonly"},
    {"path": "ad_group.type", "tool_ref": "google_create_specialized_ad_group.type", "label": "广告组类型（由 Demand Gen 自动确定）", "required": true, "source": "enum", "options": ["SEARCH_STANDARD"], "presentation": "derived_readonly"},
    {"path": "ad_group.demand_gen_ad_group_settings", "tool_ref": "google_create_specialized_ad_group.demand_gen_ad_group_settings", "label": "Demand Gen 广告组版位设置", "required": true, "presentation": "object_editor"},
    {"path": "ad.name", "tool_ref": "google_create_demand_gen_multi_asset_ad.name", "label": "广告名称", "required": true},
    {"path": "ad.final_url", "tool_ref": "google_create_demand_gen_multi_asset_ad.final_url", "label": "最终到达网址", "required": true},
    {"path": "ad.headlines", "tool_ref": "google_create_demand_gen_multi_asset_ad.headlines", "label": "标题素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "ad.descriptions", "tool_ref": "google_create_demand_gen_multi_asset_ad.descriptions", "label": "描述素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "ad.business_name", "tool_ref": "google_create_demand_gen_multi_asset_ad.business_name", "label": "商家名称", "required": true},
    {"path": "ad.marketing_images", "tool_ref": "google_create_demand_gen_multi_asset_ad.marketing_images", "label": "横版营销图片", "required": false, "source": "lookup", "lookup_tool": "google_list_assets", "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.square_marketing_images", "tool_ref": "google_create_demand_gen_multi_asset_ad.square_marketing_images", "label": "方形营销图片", "required": false, "source": "lookup", "lookup_tool": "google_list_assets", "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.portrait_marketing_images", "tool_ref": "google_create_demand_gen_multi_asset_ad.portrait_marketing_images", "label": "竖版营销图片", "required": false, "source": "lookup", "lookup_tool": "google_list_assets", "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.logo_images", "tool_ref": "google_create_demand_gen_multi_asset_ad.logo_images", "label": "Logo 图片", "required": false, "source": "lookup", "lookup_tool": "google_list_assets", "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.call_to_action_text", "tool_ref": "google_create_demand_gen_multi_asset_ad.call_to_action_text", "label": "行动号召文案", "required": false}
  ],
  "rules": [{"id": "campaign_type_is_fixed", "when": {"field": "campaign.advertising_channel_type", "equals": "DEMAND_GEN"}, "preserve": ["campaign.advertising_channel_type", "ad_group.campaign_type"]}]
}
