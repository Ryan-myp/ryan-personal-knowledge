{
  "id": "google-ads.performance_max",
  "version": "1.0.0",
  "provider": "google-ads",
  "ad_format": "PERFORMANCE_MAX",
  "title": "Google Performance Max 广告",
  "description": "Performance Max 不使用传统广告组，按 Asset Group 和素材资产配置。",
  "selector": {"dimension": "ad_format", "field": "campaign.advertising_channel_type", "values": ["PERFORMANCE_MAX"], "label": "Google 广告系列类型", "options": [{"value": "PERFORMANCE_MAX", "label": "Performance Max"}]},
  "tools": ["google_create_campaign", "google_create_asset_group", "google_create_asset_group_listing_group_filter"],
  "resources": ["campaign", "asset_group", "listing_group_filter"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "google_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.contains_eu_political_advertising", "tool_ref": "google_create_campaign.contains_eu_political_advertising", "label": "欧盟政治广告声明", "required": true, "source": "enum", "options": ["DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING", "CONTAINS_EU_POLITICAL_ADVERTISING"]},
    {"path": "campaign.advertising_channel_type", "tool_ref": "google_create_campaign.advertising_channel_type", "label": "广告系列类型（已根据入口匹配）", "required": true, "source": "enum", "options": ["PERFORMANCE_MAX"], "presentation": "derived_readonly"},
    {"path": "campaign.campaign_goal_setting.optimization_goal_types", "tool_ref": "google_create_campaign.campaign_goal_setting.optimization_goal_types", "label": "优化目标（可选）", "required": false, "source": "enum", "options": ["CALL_CLICKS", "DRIVING_DIRECTIONS", "APP_PRE_REGISTRATION"]},
    {"path": "campaign.brand_guidelines_enabled", "tool_ref": "google_create_campaign.brand_guidelines_enabled", "label": "启用品牌指南", "required": false, "source": "enum", "options": [true, false], "default": false},
    {"path": "campaign.shopping_setting", "tool_ref": "google_create_campaign.shopping_setting", "label": "Merchant Center 商品来源（零售 PMax 可选）", "required": false, "source": "tool_schema", "description": "只有绑定 Merchant Center 的零售型 PMax 才填写；绑定后才能创建 PMax 商品筛选树。"},
    {"path": "campaign.bidding_strategy", "tool_ref": "google_create_campaign.bidding_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["MAXIMIZE_CONVERSIONS", "MAXIMIZE_CONVERSION_VALUE", "TARGET_CPA", "TARGET_ROAS"], "option_labels": {"MAXIMIZE_CONVERSIONS": "最大化转化次数", "MAXIMIZE_CONVERSION_VALUE": "最大化转化价值", "TARGET_CPA": "目标 CPA", "TARGET_ROAS": "目标 ROAS"}},
    {"path": "campaign.target_cpa_micros", "tool_ref": "google_create_campaign.target_cpa_micros", "label": "目标 CPA", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}},
    {"path": "campaign.target_roas", "tool_ref": "google_create_campaign.target_roas", "label": "目标 ROAS", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}},
    {"path": "campaign.daily_budget", "tool_ref": "google_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "asset_group.name", "tool_ref": "google_create_asset_group.name", "label": "Asset Group 名称", "required": true},
    {"path": "asset_group.asset_group_type", "tool_ref": "google_create_asset_group.asset_group_type", "label": "Asset Group 类型（自动匹配）", "required": true, "source": "enum", "options": ["PERFORMANCE_MAX"], "presentation": "derived_readonly"},
    {"path": "asset_group.final_urls", "tool_ref": "google_create_asset_group.final_urls", "label": "落地页网址（每行一条）", "required": true, "presentation": "text_list"},
    {"path": "asset_group.headlines", "tool_ref": "google_create_asset_group.headlines", "label": "标题素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "asset_group.long_headlines", "tool_ref": "google_create_asset_group.long_headlines", "label": "长标题素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "asset_group.descriptions", "tool_ref": "google_create_asset_group.descriptions", "label": "描述素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "asset_group.images", "tool_ref": "google_create_asset_group.images", "label": "营销图片素材", "required": true, "presentation": "asset_picker", "accept": "image/*"},
    {"path": "asset_group.square_marketing_images", "tool_ref": "google_create_asset_group.square_marketing_images", "label": "方形营销图片素材", "required": true, "presentation": "asset_picker", "accept": "image/*"},
    {"path": "asset_group.logos", "tool_ref": "google_create_asset_group.logos", "label": "品牌 Logo 素材", "required": true, "presentation": "asset_picker", "accept": "image/*"},
    {"path": "asset_group.business_names", "tool_ref": "google_create_asset_group.business_names", "label": "商家名称素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "asset_group.videos", "tool_ref": "google_create_asset_group.videos", "label": "视频素材", "required": false, "presentation": "asset_picker", "accept": "video/*"},
    {"path": "listing_group_filter.filter_type", "tool_ref": "google_create_asset_group_listing_group_filter.filter_type", "label": "商品筛选节点类型", "required": false, "source": "enum", "options": ["SUBDIVISION", "UNIT_INCLUDED", "UNIT_EXCLUDED"], "option_labels": {"SUBDIVISION": "细分节点", "UNIT_INCLUDED": "包含商品", "UNIT_EXCLUDED": "排除商品"}},
    {"path": "listing_group_filter.listing_source", "tool_ref": "google_create_asset_group_listing_group_filter.listing_source", "label": "商品来源", "required": false, "source": "enum", "options": ["SHOPPING", "WEBPAGE", "RETAIL"], "option_labels": {"SHOPPING": "Merchant Center 商品", "WEBPAGE": "网页/页面 Feed", "RETAIL": "Retail Product Tags"}},
    {"path": "listing_group_filter.parent_filter_id", "tool_ref": "google_create_asset_group_listing_group_filter.parent_filter_id", "label": "父级商品筛选节点", "required": false, "source": "lookup", "presentation": "object_editor", "description": "创建根节点时留空；创建子节点时从当前 Asset Group 的筛选树中选择。"},
    {"path": "listing_group_filter.product_dimension", "tool_ref": "google_create_asset_group_listing_group_filter.product_dimension", "label": "商品筛选维度", "required": false, "source": "enum", "options": ["PRODUCT_TYPE", "PRODUCT_BRAND", "PRODUCT_CATEGORY", "PRODUCT_CHANNEL", "PRODUCT_CONDITION", "PRODUCT_CUSTOM_ATTRIBUTE", "PRODUCT_ITEM_ID", "WEBPAGE", "RETAIL_FILTER_BUNDLE"], "option_labels": {"PRODUCT_TYPE": "商品类型", "PRODUCT_BRAND": "品牌", "PRODUCT_CATEGORY": "商品类别", "PRODUCT_CHANNEL": "销售渠道", "PRODUCT_CONDITION": "商品状况", "PRODUCT_CUSTOM_ATTRIBUTE": "自定义标签", "PRODUCT_ITEM_ID": "商品 ID", "WEBPAGE": "网页条件", "RETAIL_FILTER_BUNDLE": "Retail 筛选包"}, "visible_when": {"any": [{"field": "listing_group_filter.filter_type", "in": ["UNIT_INCLUDED", "UNIT_EXCLUDED"]}, {"field": "listing_group_filter.listing_source", "equals": "WEBPAGE"}]}},
    {"path": "listing_group_filter.value", "tool_ref": "google_create_asset_group_listing_group_filter.value", "label": "维度值", "required": false, "visible_when": {"field": "listing_group_filter.product_dimension", "in": ["PRODUCT_TYPE", "PRODUCT_BRAND", "PRODUCT_CATEGORY", "PRODUCT_CHANNEL", "PRODUCT_CONDITION", "PRODUCT_CUSTOM_ATTRIBUTE", "PRODUCT_ITEM_ID"]}},
    {"path": "listing_group_filter.dimension_level", "tool_ref": "google_create_asset_group_listing_group_filter.dimension_level", "label": "类型/类别层级", "required": false, "source": "enum", "options": ["LEVEL1", "LEVEL2", "LEVEL3", "LEVEL4", "LEVEL5"], "visible_when": {"field": "listing_group_filter.product_dimension", "in": ["PRODUCT_TYPE", "PRODUCT_CATEGORY"]}},
    {"path": "listing_group_filter.custom_attribute_index", "tool_ref": "google_create_asset_group_listing_group_filter.custom_attribute_index", "label": "自定义标签序号", "required": false, "source": "enum", "options": ["INDEX0", "INDEX1", "INDEX2", "INDEX3", "INDEX4"], "visible_when": {"field": "listing_group_filter.product_dimension", "equals": "PRODUCT_CUSTOM_ATTRIBUTE"}},
    {"path": "listing_group_filter.webpage_conditions", "tool_ref": "google_create_asset_group_listing_group_filter.webpage_conditions", "label": "网页筛选条件", "required": false, "presentation": "object_editor", "visible_when": {"field": "listing_group_filter.product_dimension", "equals": "WEBPAGE"}},
    {"path": "listing_group_filter.retail_filter_shared_set", "tool_ref": "google_create_asset_group_listing_group_filter.retail_filter_shared_set", "label": "Retail SharedSet", "required": false, "visible_when": {"field": "listing_group_filter.product_dimension", "equals": "RETAIL_FILTER_BUNDLE"}}
  ],
  "rules": [{"id": "bidding_strategy_changed", "when": {"field": "campaign.bidding_strategy", "changed": true}, "reset": ["campaign.target_cpa_micros", "campaign.target_roas"]}, {"id": "listing_source_changed", "when": {"field": "listing_group_filter.listing_source", "changed": true}, "reset": ["listing_group_filter.product_dimension", "listing_group_filter.value", "listing_group_filter.dimension_level", "listing_group_filter.custom_attribute_index", "listing_group_filter.webpage_conditions", "listing_group_filter.retail_filter_shared_set"]}]
}
