{
  "id": "google-ads.app",
  "version": "1.0.0",
  "provider": "google-ads",
  "ad_format": "APP",
  "title": "Google App 广告",
  "description": "Google App Campaign 使用专属的 App 设置、广告组和素材字段。",
  "match_terms": ["App 广告", "App 转化", "app campaign", "app conversion", "app install"],
  "selector": {"dimension": "ad_format", "field": "campaign.campaign_type", "values": ["APP"], "label": "Google 广告系列类型", "options": [{"value": "APP", "label": "应用"}]},
  "tools": ["google_create_campaign", "google_create_app_ad_group", "google_create_app_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.campaign_name", "tool_ref": "google_create_campaign.campaign_name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.campaign_type", "tool_ref": "google_create_campaign.campaign_type", "label": "广告系列类型（已根据入口匹配）", "required": true, "source": "enum", "options": ["APP"], "presentation": "derived_readonly"},
    {"path": "campaign.advertising_channel_type", "tool_ref": "google_create_campaign.advertising_channel_type", "label": "Google API 渠道类型（自动匹配）", "required": true, "source": "enum", "options": ["MULTI_CHANNEL"], "presentation": "derived_readonly"},
    {"path": "campaign.advertising_channel_sub_type", "tool_ref": "google_create_campaign.advertising_channel_sub_type", "label": "App Campaign 类型", "required": true, "source": "enum", "options": ["APP_CAMPAIGN", "APP_CAMPAIGN_FOR_ENGAGEMENT"], "option_labels": {"APP_CAMPAIGN": "应用安装", "APP_CAMPAIGN_FOR_ENGAGEMENT": "应用互动"}},
    {"path": "campaign.app_campaign_setting", "tool_ref": "google_create_campaign.app_campaign_setting", "label": "App Campaign 设置", "required": true},
    {"path": "campaign.bidding_strategy", "tool_ref": "google_create_campaign.bidding_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["MAXIMIZE_CONVERSIONS", "TARGET_CPA", "MAXIMIZE_CONVERSION_VALUE", "TARGET_ROAS"], "option_labels": {"MAXIMIZE_CONVERSIONS": "最大化转化次数", "TARGET_CPA": "目标 CPA", "MAXIMIZE_CONVERSION_VALUE": "最大化转化价值", "TARGET_ROAS": "目标 ROAS"}},
    {"path": "campaign.target_cpa_micros", "tool_ref": "google_create_campaign.target_cpa_micros", "label": "目标 CPA", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_CPA"}},
    {"path": "campaign.target_roas", "tool_ref": "google_create_campaign.target_roas", "label": "目标 ROAS", "visible_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}, "required_when": {"field": "campaign.bidding_strategy", "equals": "TARGET_ROAS"}},
    {"path": "campaign.daily_budget", "tool_ref": "google_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "ad_group.name", "tool_ref": "google_create_app_ad_group.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.type", "tool_ref": "google_create_app_ad_group.type", "label": "广告组类型（自动匹配）", "required": true, "source": "enum", "options": ["SEARCH_STANDARD"], "presentation": "derived_readonly"},
    {"path": "ad.name", "tool_ref": "google_create_app_ad.name", "label": "广告名称", "required": true},
    {"path": "ad.headlines", "tool_ref": "google_create_app_ad.headlines", "label": "标题素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "ad.descriptions", "tool_ref": "google_create_app_ad.descriptions", "label": "描述素材（每行一条）", "required": true, "presentation": "text_list", "value_shape": "object_text"},
    {"path": "ad.images", "tool_ref": "google_create_app_ad.images", "label": "图片素材", "required": false, "presentation": "asset_picker", "accept": "image/*"},
    {"path": "ad.videos", "tool_ref": "google_create_app_ad.videos", "label": "视频素材", "required": false, "presentation": "asset_picker", "accept": "video/*"}
  ],
  "rules": [
    {"id": "bidding_strategy_changed", "when": {"field": "campaign.bidding_strategy", "changed": true}, "reset": ["campaign.target_cpa_micros", "campaign.target_roas"]},
    {"id": "app_subtype_changed", "when": {"field": "campaign.advertising_channel_sub_type", "changed": true}, "reset": ["campaign.app_campaign_setting"]}
  ]
}
