{
  "id": "tiktok.spark",
  "version": "1.0.0",
  "provider": "tiktok",
  "ad_format": "SPARK_AD",
  "title": "TikTok Spark Ads",
  "description": "使用已授权的 TikTok 帖子创建 Spark Ads；帖子 ID 不会由名称推断。",
  "match_terms": ["Spark Ads", "Spark 广告", "达人帖子广告", "原生帖子推广"],
  "selector": {
    "dimension": "objective",
    "field": "campaign.objective_type",
    "values": ["VIDEO_VIEWS", "ENGAGEMENT"],
    "label": "TikTok 推广目标",
    "options": [
      {"value": "VIDEO_VIEWS", "label": "视频观看"},
      {"value": "ENGAGEMENT", "label": "互动"}
    ]
  },
  "tools": ["tiktok_create_campaign", "tiktok_create_adgroup", "tiktok_spark_ads_create"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.name", "tool_ref": "tiktok_create_campaign.name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.objective_type", "tool_ref": "tiktok_create_campaign.objective_type", "label": "推广目标（已根据入口匹配）", "required": true, "source": "enum", "options": ["VIDEO_VIEWS", "ENGAGEMENT"], "presentation": "derived_readonly"},
    {"path": "campaign.campaign_type", "tool_ref": "tiktok_create_campaign.campaign_type", "label": "Campaign 类型", "required": true, "source": "enum", "options": ["REGULAR_CAMPAIGN", "IOS14_CAMPAIGN"]},
    {"path": "campaign.budget_mode", "tool_ref": "tiktok_create_campaign.budget_mode", "label": "预算模式", "required": true, "source": "enum", "options": ["BUDGET_MODE_DAY", "BUDGET_MODE_TOTAL"]},
    {"path": "campaign.daily_budget", "tool_ref": "tiktok_create_campaign.daily_budget", "label": "日预算", "required_when": {"field": "campaign.budget_mode", "equals": "BUDGET_MODE_DAY"}},
    {"path": "ad_group.name", "tool_ref": "tiktok_create_adgroup.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.campaign_id", "tool_ref": "tiktok_create_adgroup.campaign_id", "label": "所属 Campaign", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_campaigns"},
    {"path": "ad_group.promotion_type", "tool_ref": "tiktok_create_adgroup.promotion_type", "label": "推广方式", "required": true, "source": "enum", "options": ["WEBSITE_OR_DISPLAY"]},
    {"path": "ad_group.optimization_goal", "tool_ref": "tiktok_create_adgroup.optimization_goal", "label": "优化目标", "required": true, "source": "enum", "options": ["VIDEO_VIEW", "ENGAGEMENT"], "options_from": ["campaign.objective_type"], "option_rules": [{"when": {"field": "campaign.objective_type", "equals": "VIDEO_VIEWS"}, "options": ["VIDEO_VIEW"]}, {"when": {"field": "campaign.objective_type", "equals": "ENGAGEMENT"}, "options": ["ENGAGEMENT"]}]},
    {"path": "ad_group.billing_event", "tool_ref": "tiktok_create_adgroup.billing_event", "label": "计费事件", "required": true, "source": "enum", "options": ["CPV", "CPM", "CPC"]},
    {"path": "ad_group.budget_mode", "tool_ref": "tiktok_create_adgroup.budget_mode", "label": "广告组预算模式", "required": true, "source": "enum", "options": ["BUDGET_MODE_DAY", "BUDGET_MODE_INFINITE"]},
    {"path": "ad_group.budget", "tool_ref": "tiktok_create_adgroup.budget", "label": "广告组预算", "required": true},
    {"path": "ad_group.schedule_type", "tool_ref": "tiktok_create_adgroup.schedule_type", "label": "投放时间设置", "required": true, "source": "enum", "options": ["SCHEDULE_FROM_NOW", "SCHEDULE_START_END"]},
    {"path": "ad_group.schedule_start_time", "tool_ref": "tiktok_create_adgroup.schedule_start_time", "label": "开始投放时间", "required": true},
    {"path": "ad_group.location_ids", "tool_ref": "tiktok_create_adgroup.location_ids", "label": "投放地区", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_regions"},
    {"path": "ad_group.placement_type", "tool_ref": "tiktok_create_adgroup.placement_type", "label": "版位模式", "required": true, "source": "enum", "options": ["PLACEMENT_TYPE_NORMAL", "PLACEMENT_TYPE_AUTOMATIC"]},
    {"path": "ad_group.bid_type", "tool_ref": "tiktok_create_adgroup.bid_type", "label": "出价方式", "required": true, "source": "enum", "options": ["BID_TYPE_NO_BID", "BID_TYPE_CUSTOM", "BID_TYPE_MAX_CONVERSION"]},
    {"path": "ad.spark_post_id", "tool_ref": "tiktok_spark_ads_create.spark_post_id", "label": "Spark 帖子授权标识", "required": true, "presentation": "text_list"}
  ],
  "rules": [
    {"id": "objective_changed", "when": {"field": "campaign.objective_type", "changed": true}, "reset": ["ad_group.optimization_goal", "ad_group.billing_event"]}
  ]
}
