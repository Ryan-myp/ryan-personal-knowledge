{
  "id": "tiktok.product_sales_video",
  "version": "1.0.0",
  "provider": "tiktok",
  "ad_format": "SINGLE_VIDEO",
  "title": "TikTok 商品销售视频广告",
  "description": "按 TikTok 商品销售目标选择推广方式、商品来源、优化目标和素材。",
  "match_terms": ["商品销售", "商品广告", "product sales", "product ad"],
  "selector": {"dimension": "objective", "field": "campaign.objective_type", "values": ["PRODUCT_SALES", "SHOP_PURCHASES", "CATALOG_SALES"], "label": "TikTok 推广目标", "options": [{"value": "PRODUCT_SALES", "label": "商品销售"}, {"value": "SHOP_PURCHASES", "label": "Shop 购买"}, {"value": "CATALOG_SALES", "label": "目录销售"}]},
  "tools": ["tiktok_create_campaign", "tiktok_create_product_sales_adgroup", "tiktok_create_product_sales_ad"],
  "resources": ["campaign", "ad_group", "ad"],
  "fields": [
    {"path": "campaign.name", "tool_ref": "tiktok_create_campaign.name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.objective_type", "tool_ref": "tiktok_create_campaign.objective_type", "label": "推广目标（已根据入口匹配）", "required": true, "source": "enum", "options": ["PRODUCT_SALES", "SHOP_PURCHASES", "CATALOG_SALES"], "presentation": "derived_readonly"},
    {"path": "campaign.campaign_type", "tool_ref": "tiktok_create_campaign.campaign_type", "label": "Campaign 类型", "required": true, "source": "enum", "options": ["REGULAR_CAMPAIGN"]},
    {"path": "campaign.budget_mode", "tool_ref": "tiktok_create_campaign.budget_mode", "label": "预算模式", "required": true, "source": "enum", "options": ["BUDGET_MODE_DAY", "BUDGET_MODE_TOTAL"]},
    {"path": "campaign.daily_budget", "tool_ref": "tiktok_create_campaign.daily_budget", "label": "日预算", "required_when": {"field": "campaign.budget_mode", "equals": "BUDGET_MODE_DAY"}},
    {"path": "ad_group.name", "tool_ref": "tiktok_create_product_sales_adgroup.name", "label": "广告组名称", "required": true},
    {"path": "ad_group.promotion_type", "tool_ref": "tiktok_create_product_sales_adgroup.promotion_type", "label": "推广方式", "required": true, "source": "enum", "options": ["WEBSITE", "CATALOG"]},
    {"path": "ad_group.optimization_goal", "tool_ref": "tiktok_create_product_sales_adgroup.optimization_goal", "label": "优化目标", "required": true, "source": "enum", "options": ["PRODUCT_SALES", "SHOP_PURCHASES", "CATALOG_SALES", "VALUE"], "options_from": ["campaign.objective_type", "ad_group.promotion_type"], "option_rules": [{"when": {"field": "ad_group.promotion_type", "equals": "WEBSITE"}, "options": ["PRODUCT_SALES", "SHOP_PURCHASES", "VALUE"]}, {"when": {"field": "ad_group.promotion_type", "equals": "CATALOG"}, "options": ["CATALOG_SALES", "VALUE"]}], "option_labels": {"PRODUCT_SALES": "商品销售", "SHOP_PURCHASES": "店铺购买", "CATALOG_SALES": "目录销售", "VALUE": "转化价值"}},
    {"path": "ad_group.billing_event", "tool_ref": "tiktok_create_product_sales_adgroup.billing_event", "label": "计费事件", "required": true, "source": "enum", "options": ["OCPM", "CPC"], "options_from": ["ad_group.optimization_goal"], "option_rules": [{"when": {"field": "ad_group.optimization_goal", "in": ["PRODUCT_SALES", "SHOP_PURCHASES", "CATALOG_SALES", "VALUE"]}, "options": ["OCPM", "CPC"]}], "option_labels": {"OCPM": "优化千次展示（oCPM）", "CPC": "按点击计费"}},
    {"path": "ad_group.budget_mode", "tool_ref": "tiktok_create_product_sales_adgroup.budget_mode", "label": "广告组预算模式", "required": true, "source": "enum", "options": ["BUDGET_MODE_DAY", "BUDGET_MODE_INFINITE"]},
    {"path": "ad_group.budget", "tool_ref": "tiktok_create_product_sales_adgroup.budget", "label": "广告组预算", "required": true},
    {"path": "ad_group.location_ids", "tool_ref": "tiktok_create_product_sales_adgroup.location_ids", "label": "投放地区", "required": true, "source": "lookup", "lookup_tool": "tiktok_list_locations"},
    {"path": "ad_group.placement_type", "tool_ref": "tiktok_create_product_sales_adgroup.placement_type", "label": "版位模式", "required": true, "source": "enum", "options": ["PLACEMENT_TYPE_NORMAL", "PLACEMENT_TYPE_AUTOMATIC"]},
    {"path": "ad_group.bid_type", "tool_ref": "tiktok_create_product_sales_adgroup.bid_type", "label": "出价方式", "required": true, "source": "enum", "options": ["BID_TYPE_NO_BID", "BID_TYPE_CUSTOM", "BID_TYPE_MAX_CONVERSION"]},
    {"path": "ad_group.product_source", "tool_ref": "tiktok_create_product_sales_adgroup.product_source", "label": "商品来源", "required": true, "source": "enum", "options": ["CATALOG", "STORE", "SHOWCASE"]},
    {"path": "ad.name", "tool_ref": "tiktok_create_product_sales_ad.name", "label": "广告名称", "required": true},
    {"path": "ad.ad_format", "tool_ref": "tiktok_create_product_sales_ad.ad_format", "label": "素材形式", "required": true, "source": "enum", "options": ["SINGLE_VIDEO"]},
    {"path": "ad.media", "tool_ref": "tiktok_create_product_sales_ad.media", "label": "视频素材", "required": true, "presentation": "asset_picker", "accept": "video/*"},
    {"path": "ad.product_source", "tool_ref": "tiktok_create_product_sales_ad.product_source", "label": "广告商品来源", "required": true, "source": "enum", "options": ["CATALOG", "STORE", "SHOWCASE"]}
  ],
  "rules": [{"id": "promotion_type_changed", "when": {"field": "ad_group.promotion_type", "changed": true}, "reset": ["ad_group.product_source", "ad.product_source"]}]
}
