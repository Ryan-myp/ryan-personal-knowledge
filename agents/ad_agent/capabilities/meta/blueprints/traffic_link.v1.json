{
  "id": "meta.traffic_link",
  "version": "1.0.0",
  "provider": "meta",
  "ad_format": "link_traffic",
  "title": "Meta 流量链接广告",
  "description": "按 Meta 流量目标创建 Campaign、Ad Set 和链接广告。",
  "match_terms": ["流量广告", "网站流量", "traffic campaign", "link traffic"],
  "selector": {
    "dimension": "objective",
    "field": "campaign.objective",
    "values": ["OUTCOME_TRAFFIC", "TRAFFIC", "LINK_CLICKS"],
    "label": "Meta 推广目标",
    "options": [
      {"value": "OUTCOME_TRAFFIC", "label": "流量"},
      {"value": "TRAFFIC", "label": "网站流量（旧目标）"},
      {"value": "LINK_CLICKS", "label": "链接点击（旧目标）"}
    ]
  },
  "tools": ["meta_create_campaign", "meta_create_adset", "meta_create_traffic_ad"],
  "resources": ["campaign", "ad_set", "ad"],
  "fields": [
    {"path": "campaign.name", "tool_ref": "meta_create_campaign.name", "label": "Campaign 名称", "required": true},
    {"path": "campaign.objective", "tool_ref": "meta_create_campaign.objective", "label": "推广目标（已根据入口匹配）", "required": true, "source": "enum", "options": ["OUTCOME_TRAFFIC", "TRAFFIC", "LINK_CLICKS"], "presentation": "derived_readonly"},
    {"path": "campaign.special_ad_categories", "tool_ref": "meta_create_campaign.special_ad_categories", "label": "特殊广告类别", "required": true, "source": "enum"},
    {"path": "campaign.buying_type", "tool_ref": "meta_create_campaign.buying_type", "label": "购买类型", "required": true, "source": "enum", "options": ["AUCTION", "RESERVED"]},
    {"path": "campaign.daily_budget", "tool_ref": "meta_create_campaign.daily_budget", "label": "日预算", "required": true},
    {"path": "ad_set.name", "tool_ref": "meta_create_adset.name", "label": "广告组名称", "required": true},
    {"path": "ad_set.optimization_goal", "tool_ref": "meta_create_adset.optimization_goal", "label": "优化目标", "required": true, "source": "enum", "options_from": ["campaign.objective"], "option_rules": [{"when": {"field": "campaign.objective", "in": ["OUTCOME_TRAFFIC", "TRAFFIC", "LINK_CLICKS"]}, "options": ["LINK_CLICKS", "LANDING_PAGE_VIEWS"]}], "option_labels": {"LINK_CLICKS": "链接点击", "LANDING_PAGE_VIEWS": "落地页浏览"}},
    {"path": "ad_set.billing_event", "tool_ref": "meta_create_adset.billing_event", "label": "计费事件", "required": true, "source": "enum", "options_from": ["ad_set.optimization_goal"], "option_rules": [{"when": {"field": "ad_set.optimization_goal", "equals": "LINK_CLICKS"}, "options": ["IMPRESSIONS", "LINK_CLICKS"]}, {"when": {"field": "ad_set.optimization_goal", "equals": "LANDING_PAGE_VIEWS"}, "options": ["IMPRESSIONS"]}], "option_labels": {"IMPRESSIONS": "展示（按展示计费）", "LINK_CLICKS": "链接点击"}},
    {"path": "ad_set.bid_strategy", "tool_ref": "meta_create_adset.bid_strategy", "label": "出价策略", "required": true, "source": "enum", "options": ["LOWEST_COST_WITHOUT_CAP", "LOWEST_COST_WITH_BID_CAP", "COST_CAP", "LOWEST_COST_WITH_MIN_ROAS"], "option_labels": {"LOWEST_COST_WITHOUT_CAP": "最低成本（不限额）", "LOWEST_COST_WITH_BID_CAP": "最低成本（出价上限）", "COST_CAP": "成本上限", "LOWEST_COST_WITH_MIN_ROAS": "最低成本（最低 ROAS）"}},
    {"path": "ad_set.targeting", "tool_ref": "meta_create_adset.targeting", "label": "定向", "required": true},
    {"path": "ad.name", "tool_ref": "meta_create_traffic_ad.name", "label": "广告名称", "required": true},
    {"path": "ad.page_id", "tool_ref": "meta_create_traffic_ad.page_id", "label": "Facebook Page", "required": true, "source": "lookup", "lookup_tool": "meta_list_pages"},
    {"path": "ad.link", "tool_ref": "meta_create_traffic_ad.link", "label": "落地页链接", "required": true},
    {"path": "ad.media_type", "tool_ref": "meta_create_traffic_ad.media_type", "label": "素材类型", "required": true, "source": "enum", "options": ["IMAGE", "VIDEO"], "option_labels": {"IMAGE": "图片", "VIDEO": "视频"}},
    {"path": "ad.image_hash", "tool_ref": "meta_create_traffic_ad.image_hash", "label": "图片素材 ID / 本地文件草稿", "presentation": "file_reference", "accept": "image/*", "visible_when": {"field": "ad.media_type", "equals": "IMAGE"}, "required_when": {"field": "ad.media_type", "equals": "IMAGE"}},
    {"path": "ad.video_id", "tool_ref": "meta_create_traffic_ad.video_id", "label": "视频素材 ID / 本地文件草稿", "presentation": "file_reference", "accept": "video/*", "visible_when": {"field": "ad.media_type", "equals": "VIDEO"}, "required_when": {"field": "ad.media_type", "equals": "VIDEO"}}
  ],
  "rules": [
    {"id": "objective_changed", "when": {"field": "campaign.objective", "changed": true}, "reset": ["ad_set.optimization_goal", "ad_set.billing_event"]},
    {"id": "media_type_changed", "when": {"field": "ad.media_type", "changed": true}, "reset": ["ad.video_id"]}
  ]
}
